---
// A Course 3 chapter. The text comes from content/programming/chapters/<id>/chapter.md.
import Base from '../../layouts/Base.astro';
import CodeChapter from '../../components/CodeChapter.astro';
import { getProgChapters, plan, course } from '../../lib/programming.js';

export async function getStaticPaths() {
  const chapters = (await getProgChapters()).filter((c) => c.public);
  return chapters.map((ch, i) => ({ params: { slug: ch.meta.slug }, props: { ch, prev: chapters[i - 1], nextOpen: chapters[i + 1] } }));
}
const { ch, prev, nextOpen } = Astro.props;
const tierShort = { P1: 'first steps', P2: 'school and college exams', P3: 'interviews and contests', P4: 'olympiad', P5: 'systems and professional' };
---
<Base title={`Course 3, Chapter ${ch.meta.chapter_number}: ${ch.meta.short_title}`} description={ch.meta.subtitle} lang="en">
  <CodeChapter ch={ch} prev={prev} nextOpen={nextOpen} plan={plan} course={course} base="/programming/" tierShort={tierShort} />
</Base>
