---
import Base from '../../layouts/Base.astro';
import site from '../../data/site.json';
import { getPosts } from '../../lib/posts.js';
import { getChapters } from '../../lib/maths.js';
import { getProgChapters } from '../../lib/programming.js';
import { getOsChapters } from '../../lib/os.js';
const lessons = getPosts('lesson', 'hi').length;
const maths = (await getChapters()).filter((c) => c.public).length;
const prog = (await getProgChapters()).filter((c) => c.public).length;
const osN = (await getOsChapters()).filter((c) => c.public).length;
---
<Base lang="hi" title="हमारे बारे में" description="Kota Quantum Valley के पीछे कौन है, यह पहल क्या बना रही है, और आप कैसे मदद कर सकते हैं।">
  <section class="article about">
    <div class="narrow">
      <p class="eyebrow">हमारे बारे में</p>
      <h1>इसके पीछे कौन है?</h1>
      <p class="desc">Kota Quantum Valley की शुरुआत {site.founderName} ने की है, जो राजस्थान के एक एम्बेडेड फ़र्मवेयर इंजीनियर हैं।</p>

      <h2>संस्थापक</h2>
      <p>मैं {site.founderName} हूँ। मैंने गवर्नमेंट इंजीनियरिंग कॉलेज अजमेर से इलेक्ट्रॉनिक्स और कम्युनिकेशन इंजीनियरिंग (B.Tech) की पढ़ाई की, और साढ़े तीन साल से ज़्यादा समय से एम्बेडेड फ़र्मवेयर लिख रहा हूँ: वह सॉफ़्टवेयर जो इलेक्ट्रॉनिक डिवाइस के अंदर चलता है। मेरा काम स्मार्ट एनर्जी मीटरिंग फ़र्मवेयर के रिसर्च और डेवलपमेंट में है, C में, हार्डवेयर के बिल्कुल पास।</p>
      <p>क्वांटम कंप्यूटरों को ठीक इसी तरह की इंजीनियरिंग चाहिए। हर qubit को क्लासिकल इलेक्ट्रॉनिक्स और फ़र्मवेयर नियंत्रित करते हैं, जो बिल्कुल सही समय पर pulse भेजते हैं और नतीजे पढ़ते हैं। इसलिए मैं क्वांटम कंप्यूटिंग शून्य से सीख रहा हूँ, और हर क़दम यहाँ साझा कर रहा हूँ, ताकि जो भी छात्र चाहे, वही रास्ता अपना सके।</p>

      <h2>मैं किन चीज़ों के साथ काम करता हूँ</h2>
      <dl class="stack">
        <div><dt>माइक्रोकंट्रोलर</dt><dd>काम पर Renesas RL78। मेरी डेस्क पर STM32 (Arm Cortex-M), ESP32 और एक Raspberry Pi 4।</dd></div>
        <div><dt>भाषाएँ</dt><dd>Bare-metal एम्बेडेड C, जिसके नीचे कोई ऑपरेटिंग सिस्टम नहीं होता। टेस्ट स्क्रिप्ट और गणनाएँ जाँचने के लिए Python।</dd></div>
        <div><dt>प्रोटोकॉल</dt><dd>DLMS/COSEM (IEC 62056), वह मानक जिससे बिजली मीटर बिजली कंपनी के सिस्टम से बात करते हैं, उसकी सुरक्षा परत के साथ: encryption, authentication और key management।</dd></div>
        <div><dt>ऑपरेटिंग सिस्टम</dt><dd>FreeRTOS, माइक्रोकंट्रोलर के लिए एक छोटा real-time ऑपरेटिंग सिस्टम।</dd></div>
        <div><dt>अभी सीख रहा हूँ</dt><dd>CAN bus, Embedded Linux और C++।</dd></div>
      </dl>
      <p>इसीलिए प्रोग्रामिंग कोर्स C को Python के साथ पढ़ाता है, और इस साइट का हर प्रोग्राम प्रकाशित होने से पहले compile करके चलाया जाता है: फ़र्मवेयर में जो कोड असली हार्डवेयर पर नहीं चला, वह गिना नहीं जाता।</p>

      <h2>मैं क्वांटम कैसे सीख रहा हूँ</h2>
      <ul class="path-list">
        <li><strong>शुरुआत।</strong> इलेक्ट्रॉनिक्स की डिग्री क्वांटम हार्डवेयर की ज़रूरतों का अच्छा-ख़ासा हिस्सा पहले ही पढ़ा देती है: linear algebra, electromagnetic theory, semiconductor physics और फ़र्मवेयर। मेरे हिसाब से लगभग 40 प्रतिशत। बाक़ी है quantum mechanics, microwave engineering और algorithms।</li>
        <li><strong>मैं क्या पढ़ रहा हूँ।</strong> Nielsen और Chuang की <em>Quantum Computation and Quantum Information</em>, पहले अध्याय 1 और 2। हार्डवेयर के लिए मुख्य किताब: Krantz और साथियों का <em>A quantum engineer's guide to superconducting qubits</em> (Applied Physics Reviews, 2019)। जब radio-frequency वाला हिस्सा आए, तब Pozar की <em>Microwave Engineering</em>।</li>
        <li><strong>मैं किस ओर जा रहा हूँ।</strong> मेरी पृष्ठभूमि से दो रास्ते मेल खाते हैं: quantum hardware engineering, यानी qubits के आसपास के control electronics और फ़र्मवेयर; और quantum cryptography, जो उस security काम पर बनती है जो मैं पहले से करता हूँ।</li>
        <li><strong>जिस प्रोजेक्ट का लक्ष्य है।</strong> QICK, यानी Quantum Instrumentation Control Kit: Fermilab का एक open-source qubit controller जो FPGA बोर्ड पर चलता है। ठीक यही वह जगह है जहाँ फ़र्मवेयर qubits से मिलता है।</li>
        <li><strong>अभी क्यों।</strong> मेरा अनुमान है कि क्वांटम इंजीनियरों की भर्ती 2028 से 2031 के आसपास तेज़ी से बढ़ेगी। हुनर बनने में सालों लगते हैं, इसलिए मैं अभी से, सबके सामने, बना रहा हूँ।</li>
      </ul>

      <h2>मैं किन बातों में विश्वास करता हूँ</h2>
      <ol class="beliefs">
        <li><strong>गहराई, शॉर्टकट नहीं।</strong> महान किताबों से सीखो, सारांश के सारांश से नहीं, और सबसे कठिन सवाल तक जाओ। कोई विषय तब सीखा जाता है जब आप उसके कठिन सवाल हल कर सकें, तब नहीं जब आपने उस पर एक वीडियो देख लिया।</li>
        <li><strong>कोई दिखावा नहीं।</strong> "30 दिन में क्वांटम सीखो" जैसा कुछ नहीं। साफ़ बताओ कि क्या कठिन है, क्या पता है और क्या अभी research है।</li>
        <li><strong>सब कुछ जाँचो।</strong> हर दावे का स्रोत, हर गणना दोबारा चलाई हुई, हर प्रोग्राम compile करके चलाया हुआ। जो जाँचा नहीं गया, वह प्रकाशित नहीं होता।</li>
        <li><strong>कम चीज़ें, पूरी तरह।</strong> छोटी योजना जिस पर आप चलते हैं, उस लंबी योजना से बेहतर है जिसे आप छोड़ देते हैं। कठिन हिस्से पर तीन बार लौटना, सब कुछ एक बार पढ़ने से बेहतर है।</li>
        <li><strong>अपने हाथों से बनाओ।</strong> नोट्स हार्डवेयर की जगह नहीं ले सकते। समझ तब आती है जब कोई चीज़ आप चला कर दिखाएँ।</li>
        <li><strong>लिखो, सबके सामने।</strong> अगर मैं किसी बात को आसान शब्दों में नहीं समझा सकता, तो मैंने उसे अभी समझा नहीं है।</li>
        <li><strong>ज्ञान मुफ़्त होना चाहिए, और प्रतिभा को जाना नहीं पड़ना चाहिए।</strong> कोटा का कोई छात्र यह सब मुफ़्त सीख सके, और एक दिन यह काम राजस्थान छोड़े बिना कर सके।</li>
      </ol>

      <h2>यह पहल</h2>
      <p>Kota Quantum Valley के दो काम हैं।</p>
      <ol>
        <li><strong>मुफ़्त और गहराई से पढ़ाना।</strong> अगर मैं सीख सकता हूँ, तो कोटा का कोई भी छात्र सीख सकता है, और नोट्स मुफ़्त होने चाहिए। हर पाठ शून्य से शुरू होकर सबसे कठिन सवालों तक जाता है, आसान भाषा में, चलने वाले कोड और असली आउटपुट के साथ।</li>
        <li><strong>कोटा का पक्ष रखना।</strong> कोटा को भारत के क्वांटम नक्शे पर होना चाहिए, सिर्फ़ ऐसी जगह नहीं जहाँ से छात्र चले जाते हैं। <a href="/hi/why-kota/">कोटा क्यों</a> पेज स्रोतों के साथ यह तर्क रखता है।</li>
      </ol>

      <h2>अब तक हमने क्या बनाया है</h2>
      <div class="grid about-grid">
        <a class="card" href="/hi/lessons/"><h3>कोर्स 1: क्वांटम की बुनियाद</h3><p>bits से असली क्वांटम हार्डवेयर तक {lessons} पाठ, हिन्दी और English में, हर पाठ में कोड, अभ्यास और quiz।</p></a>
        <a class="card" href="/mathematics/"><h3>कोर्स 2: गणित</h3><p>क्वांटम विज्ञान के लिए गणित, कक्षा 10 से PhD स्तर तक। {maths} अध्याय खुले, हर गणना कोड में जाँची गई। (English)</p></a>
        <a class="card" href="/programming/"><h3>कोर्स 3: C और Python</h3><p>दो भाषाओं में साथ-साथ प्रोग्रामिंग, पहले प्रोग्राम से quantum simulator तक।{prog ? ` ${prog} अध्याय खुले।` : ''} (English)</p></a>
        <a class="card" href="/operating-systems/"><h3>कोर्स 4: ऑपरेटिंग सिस्टम और Embedded Linux</h3><p>Linux असल में कैसे काम करता है, और embedded बोर्ड पर उसे कैसे बनाएँ, बूट करें और प्रोग्राम करें, हर लैब आपके लैपटॉप पर।{osN ? ` ${osN} अध्याय खुले।` : ''} (English)</p></a>
        <a class="card" href="/hi/lab/"><h3>क्वांटम लैब</h3><p>ब्राउज़र में चार प्रयोग: Bloch sphere, superposition, Bell states और circuit builder।</p></a>
        <a class="card" href="/hi/great-minds/"><h3>महान विचारक</h3><p>सोलह वैज्ञानिक और गणितज्ञ, आधे भारत से, और हर एक से छात्र कौन-सी आदत सीख सकते हैं।</p></a>
        <a class="card" href="/hi/careers/"><h3>करियर और रिज़्यूमे मेकर</h3><p>कौन-सी क्वांटम नौकरियाँ हैं, उनके लिए क्या चाहिए, और एक मुफ़्त रिज़्यूमे मेकर।</p></a>
        <a class="card" href={site.instagram} rel="noopener" target="_blank"><h3>इंस्टाग्राम</h3><p>क्वांटम में नए छात्रों के लिए विस्तृत carousels, {site.instagramHandle} पर।</p></a>
      </div>

      <h2>हम कैसे काम करते हैं</h2>
      <ul>
        <li><strong>मुफ़्त।</strong> कोई पेवॉल नहीं, कोई साइन-अप नहीं। पाठ Creative Commons लाइसेंस के तहत हैं; क्रेडिट देकर शेयर करें।</li>
        <li><strong>ईमानदार।</strong> हम साफ़ बताते हैं कि क्या आज इस्तेमाल में है और क्या अभी research है, और अपने स्रोत देते हैं।</li>
        <li><strong>जाँचा हुआ।</strong> पेज प्रकाशित होने से पहले हर गणना कोड में दोबारा चलाई जाती है और हर प्रोग्राम compile करके चलाया जाता है।</li>
        <li><strong>आपकी भाषा में।</strong> कोर्स 1 और मुख्य पेज हिन्दी और English में हैं; कोर्स 2, 3 और 4 अभी English में हैं।</li>
      </ul>

      <h2>आगे क्या</h2>
      <p>कोर्स 2, 3 और 4 अध्याय-दर-अध्याय बढ़ेंगे, कोर्स 5 असली IBM हार्डवेयर पर IBM Quantum Learning के सिलेबस को फ़ॉलो करेगा, और राजस्थान क्वांटम मिशन की बात इंस्टाग्राम पर जारी रहेगी।</p>

      <h2>आप कैसे मदद कर सकते हैं</h2>
      <ul>
        <li>कोई पाठ ऐसे एक छात्र के साथ शेयर करें जिसे वह पसंद आए।</li>
        <li>कोई ग़लती मिली, या कुछ साफ़ नहीं है? हमें बताएँ; हर सुधार कोर्स को बेहतर बनाता है।</li>
        <li>कोटा के शिक्षक, संस्थान और कंपनियाँ: अगर आप क्वांटम स्किलिंग प्रोग्राम चलाना या छात्रों को इंटर्नशिप देना चाहते हैं, तो संपर्क करें।</li>
      </ul>

      <h2>संपर्क करें</h2>
      <p><a href={site.instagram} rel="noopener" target="_blank">इंस्टाग्राम {site.instagramHandle}</a> पर हमें फ़ॉलो करें{site.instagramDM ? <>, या <a href={site.instagramDM} rel="noopener" target="_blank">हमें मैसेज भेजें</a></> : null}{site.email ? <>, या <a href={`mailto:${site.email}`}>{site.email}</a> पर ईमेल करें</> : null}।</p>
    </div>
  </section>
</Base>

<style is:global>
  .about-grid { grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .about-grid a.card { text-decoration: none; color: inherit; }
  .about-grid a.card:hover h3 { color: var(--cyan); }
  .about-grid .card p { margin: 6px 0 0; }
  .stack { display: grid; gap: 10px; margin: 18px 0; }
  .stack > div { display: grid; grid-template-columns: 170px 1fr; gap: 14px; padding: 12px 16px; border: 1px solid var(--border); border-radius: var(--r-md); background: var(--panel); }
  .stack dt { font-family: var(--font-head); font-weight: 600; color: var(--cyan); }
  .stack dd { margin: 0; min-width: 0; }
  @media (max-width: 560px) { .stack > div { grid-template-columns: 1fr; gap: 4px; } }
  .path-list li, .beliefs li { margin-bottom: 10px; }
</style>
