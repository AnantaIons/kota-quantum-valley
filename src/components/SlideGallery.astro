---
import slides from '../data/slides.json';
import { t } from '../i18n.js';
const { set, lang = 'en' } = Astro.props;
const L = t[lang];
const titles = slides[set] ?? [];
const src = (i) => `/slides/${set}/${String(i + 1).padStart(2, '0')}.webp`;
---
{titles.length > 0 && (
  <section class="gallery" aria-label={L.theSlides}>
    <p class="meta">{L.tapSlide}</p>
    <div class="gallery-grid">
      {titles.map((title, i) => (
        <a href={src(i)} target="_blank" rel="noopener" class="slide">
          <img src={src(i).replace("/slides/", "/thumbs/")} alt={L.slideAlt(i + 1, title)} width="432" height="540" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" />
          <span>{i + 1}. {title}</span>
        </a>
      ))}
    </div>
  </section>
)}
