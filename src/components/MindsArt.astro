---
// Shared pencil filters, hatch patterns and colours for the sketch portraits (src/data/minds-art.json).
// Include once on any page that shows a portrait.
---
<svg class="minds-defs" width="0" height="0" aria-hidden="true" focusable="false">
  <defs>
    <pattern id="mh-g" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(38)"><line x1="0" y1="0" x2="0" y2="5" stroke="#E6C36A" stroke-width="0.9"/></pattern>
    <pattern id="mh-v" width="4.5" height="4.5" patternUnits="userSpaceOnUse" patternTransform="rotate(-50)"><line x1="0" y1="0" x2="0" y2="4.5" stroke="#A98BFF" stroke-width="0.8"/></pattern>
    <pattern id="mh-c" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(60)"><line x1="0" y1="0" x2="0" y2="6" stroke="#5E95FF" stroke-width="1"/></pattern>
    <filter id="msk-a" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.035" numOctaves="2" seed="3"/><feDisplacementMap in="SourceGraphic" scale="2.6"/></filter>
    <filter id="msk-b" x="-10%" y="-10%" width="120%" height="120%"><feTurbulence type="fractalNoise" baseFrequency="0.05" numOctaves="2" seed="11"/><feDisplacementMap in="SourceGraphic" scale="4"/></filter>
    <radialGradient id="mhalo-g" cx="50%" cy="42%" r="60%"><stop offset="0" stop-color="#2979FF" stop-opacity="0.22"/><stop offset="0.7" stop-color="#8957ff" stop-opacity="0.08"/><stop offset="1" stop-color="#8957ff" stop-opacity="0"/></radialGradient>
  </defs>
</svg>

<style is:global>
  .minds-defs { position: absolute; width: 0; height: 0; overflow: hidden; }
  .mind-art { display: block; width: 100%; height: auto; overflow: visible; }
  .mind-art .mhalo { fill: url(#mhalo-g); }
  .mind-art .mfill path { stroke: none; filter: url(#msk-a); }
  .mind-art .mfill .hg { fill: url(#mh-g); opacity: 0.45; }
  .mind-art .mfill .hv { fill: url(#mh-v); opacity: 0.55; }
  .mind-art .mfill .hc { fill: url(#mh-c); opacity: 0.45; }
  .mind-art g.ml, .mind-art g.ml2, .mind-art g.mt, .mind-art g.mv, .mind-art g.mc { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .mind-art g.ml { stroke: #E6C36A; stroke-width: 1.7; filter: url(#msk-a); }
  .mind-art g.ml2 { stroke: #F6DE9A; stroke-width: 0.8; opacity: 0.45; filter: url(#msk-b); }
  .mind-art g.mt { stroke: #E6C36A; stroke-width: 0.75; opacity: 0.8; filter: url(#msk-a); }
  .mind-art g.mv { stroke: #A98BFF; stroke-width: 1.1; opacity: 0.9; filter: url(#msk-a); }
  .mind-art g.mc { stroke: #5E95FF; stroke-width: 1.4; filter: url(#msk-a); }
  .mind-art .mdot { fill: #E6C36A; }
  .mind-art .mstar { fill: #F6DE9A; }
  .mind-art .mhead { fill: #A98BFF; }
  .mind-art .mtxt { fill: #F6DE9A; font: 600 13px var(--font-body); }
  .mind-art .mtick { fill: #8f9bbd; font: 11px var(--font-mono); }
</style>
