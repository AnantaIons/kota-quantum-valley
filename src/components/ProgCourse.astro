---
// Course 3 overview page (English only for now). Course data comes from content/programming.
import Solid from './Solid.astro';
import '../styles/course-overview.css';
import { getProgChapters, course, plan } from '../lib/programming.js';
const chapters = (await getProgChapters()).filter((c) => c.public);
const open = new Set(chapters.map((c) => c.meta.chapter_number));
const slugOf = Object.fromEntries(chapters.map((c) => [c.meta.chapter_number, c.meta.slug]));
const ch0 = chapters.find((c) => c.meta.chapter_number === 0);
const startHref = ch0 ? `/programming/${ch0.meta.slug}/` : '#plan';
const parts = course.parts.map((p) => ({ ...p, chapters: plan.chapters.filter((c) => c.part === p.n) }));
const tierRows = Object.entries(course.tiers);
const opened = chapters.length;
---
<section class="hero mhero phero">
  <div class="hero-glow" aria-hidden="true"></div>
  <div class="wrap mhero-grid">
    <div>
      <p class="eyebrow">Course 3, free, starting now</p>
      <h1>Programming in C and Python</h1>
      <p class="lead">Two languages, side by side, in every chapter. C shows you what the machine really does: memory, the compiler, the operating system. Python shows you how to get real work done quickly. From your first program to writing your own quantum simulator in both.</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href={startHref}>Start Chapter 0</a>
        <a class="btn btn-ghost btn-lg" href="#plan">See all {plan.chapters.length} chapters</a>
      </div>
      <p class="mhero-status">{opened ? `${opened === 1 ? 'Chapter 0 is' : `Chapters 0 to ${opened - 1} are`} open. Every program on every page is compiled and run by our tests before it is published.` : 'Chapters are being written.'}</p>
    </div>
    <div class="v3host mhero-art" data-3d="gem" aria-hidden="true"><Solid shape="octa" tone="gold" size={240} /></div>
  </div>
</section>

<section class="block" style="padding-top: 0">
  <div class="wrap">
    <div class="pc-sample glass">
      <div class="pc-sample-copy">
        <h2>The same idea, twice</h2>
        <p>Every concept appears in C and in Python next to each other. The differences are the lesson: why C declares types, why Python needs no compile step, why one runs twenty times faster than the other on a loop.</p>
      </div>
      <div class="pc-code">
        <figure><figcaption class="pc-c">C</figcaption><pre><code>{`#include <stdio.h>

int main(void)
{
    printf("Hello, Kota!\\n");
    return 0;
}`}</code></pre></figure>
        <figure><figcaption class="pc-py">Python</figcaption><pre><code>{`print("Hello, Kota!")`}</code></pre></figure>
      </div>
    </div>
  </div>
</section>

<section class="block tint">
  <div class="wrap">
    <div class="section-head"><h2>How every chapter is built</h2><p>{course.approach}</p></div>
    <ol class="how-steps">
      {course.depth_standard.map((d, i) => <li><strong>{['Side by side', 'Real output', 'Underneath', 'A ladder of problems', 'Quantum where it fits'][i]}</strong><span>{d}</span></li>)}
    </ol>
    <div class="table-wrap pc-tiers"><table>
      <thead><tr><th>Tier</th><th>Level</th></tr></thead>
      <tbody>{tierRows.map(([k, v]) => <tr><td><strong>{k}</strong></td><td>{v}</td></tr>)}</tbody>
    </table></div>
  </div>
</section>

<section class="block" id="plan">
  <div class="wrap">
    <div class="section-head"><h2>The full plan</h2><p>Ten parts, {plan.chapters.length} chapters. Open chapters are linked; the rest are planned and will open in order.</p></div>
    <div class="pc-parts">
      {parts.map((p) => (
        <details class="pc-part glass" open={p.n <= 1}>
          <summary><span class="pc-pn">Part {p.n}</span><strong>{p.name}</strong><small>{p.question}</small></summary>
          <ol class="pc-chs">
            {p.chapters.map((c) => (
              <li class={open.has(c.n) ? 'is-open' : ''}>
                <span class="pc-n">{c.n}</span>
                <div>
                  {open.has(c.n) ? <a href={`/programming/${slugOf[c.n]}/`}>{c.title}</a> : <span class="pc-t">{c.title}</span>}
                  <p>{c.objective}</p>
                  <p class="pc-langs"><span class="pc-c">C</span> {c.c_focus} <span class="pc-py">Python</span> {c.python_focus}</p>
                </div>
                <span class={`status ${open.has(c.n) ? 'now' : 'research'}`}>{open.has(c.n) ? 'Open' : 'Planned'}</span>
              </li>
            ))}
          </ol>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  import { boot3d } from '../scripts/three/boot.js';
  boot3d();
</script>
