---
// Resume maker: a form on the left, a live A4 preview on the right, and "Download PDF" via the
// browser's own print-to-PDF. Everything runs in the browser; nothing is sent anywhere.
const { lang = 'en' } = Astro.props;
const hi = lang === 'hi';

const ui = hi ? {
  eyebrow: 'रिज़्यूमे मेकर',
  h1: 'दस मिनट में अपना रिज़्यूमे बनाइए।',
  sub: 'ख़ाने भरिए और रिज़्यूमे साथ-साथ बनता देखिए। फिर PDF डाउनलोड कीजिए। मुफ़्त, कोई sign-up नहीं, और सब कुछ आपके फ़ोन या कंप्यूटर पर ही रहता है।',
  privacy: 'आप जो लिखते या लाते हैं वह कहीं upload नहीं होता। वह सिर्फ़ इसी browser में सेव रहता है, ताकि आप बाद में लौटकर बदल सकें।',
  importNote: 'पहले से रिज़्यूमे है? "मेरा रिज़्यूमे लाएँ" दबाकर PDF, Word (.docx) या text फ़ाइल चुनें, ख़ाने अपने-आप भर जाएँगे। फ़ाइल आपके browser के अंदर ही पढ़ी जाती है।',
  contentNote: 'ज़्यादातर नौकरियों के लिए रिज़्यूमे अंग्रेज़ी में लिखा जाता है, इसलिए उदाहरण अंग्रेज़ी में है। आप चाहें तो हिन्दी में भी लिख सकते हैं।',
} : {
  eyebrow: 'Resume maker',
  h1: 'Make your resume in ten minutes.',
  sub: 'Fill in the boxes and watch your resume take shape. Then download it as a PDF. Free, no sign-up, and everything stays on your phone or computer.',
  privacy: "Nothing you type or import is uploaded anywhere. It's saved only in this browser, so you can come back and edit it later.",
  importNote: 'Already have a resume? Press "Import my resume" and choose a PDF, Word (.docx) or text file to fill the boxes automatically. The file is read inside your browser.',
  contentNote: '',
};

// Text the script needs (must be plain JSON).
const S = hi ? {
  importBtn: 'मेरा रिज़्यूमे लाएँ', reading: 'आपकी फ़ाइल पढ़ी जा रही है…', imported: 'आपके रिज़्यूमे से भर दिया गया। हर ख़ाना एक बार जाँच लें: अपने-आप पढ़ना कभी पूरी तरह सही नहीं होता, ख़ासकर दो कॉलम वाले रिज़्यूमे में।', undo: 'वापस पहले जैसा करें',
  importError: 'यह फ़ाइल पढ़ी नहीं जा सकी। PDF, Word .docx या .txt फ़ाइल चुनें। पुरानी .doc फ़ाइल को पहले .docx या PDF में सेव करें।', importEmpty: 'इस फ़ाइल में कोई text नहीं मिला। स्कैन किए गए PDF (काग़ज़ की फ़ोटो) में पढ़ने लायक text नहीं होता; Word या text वाला रूप आज़माएँ।',
  template: 'डिज़ाइन', templates: { classic: 'क्लासिक', modern: 'मॉडर्न', elegant: 'एलिगेंट' },
  edit: 'भरें', preview: 'देखें', download: 'PDF डाउनलोड करें', example: 'उदाहरण से भरें', save: 'फ़ाइल में सेव करें', open: 'सेव की फ़ाइल खोलें',
  clear: 'नए सिरे से शुरू करें', clearConfirm: 'सब मिटाने के लिए फिर दबाएँ', size: 'अक्षरों का आकार', normal: 'सामान्य', compact: 'छोटा',
  headLang: 'शीर्षक', credit: 'नीचे छोटी-सी पंक्ति जोड़ें: "Made with kotaquantumvalley.in"',
  fit1: 'एक पेज में आ रहा है',
  printHint: 'Print वाली खिड़की में printer की जगह "Save as PDF" चुनें।',
  openError: 'यह फ़ाइल पढ़ी नहीं जा सकी। इसी पेज से सेव की गई .json फ़ाइल चुनें।',
  add: 'जोड़ें', remove: 'हटाएँ', up: 'ऊपर', down: 'नीचे', tapToAdd: 'जोड़ने के लिए दबाएँ:',
  sections: {
    basics: ['आपकी जानकारी', ''],
    summary: ['सारांश', 'दो-तीन पंक्तियाँ: आप कौन हैं, किसमें अच्छे हैं, और आगे क्या करना चाहते हैं।'],
    education: ['शिक्षा', 'सबसे नई पढ़ाई सबसे ऊपर।'],
    experience: ['इंटर्नशिप और अनुभव', 'हर पंक्ति किसी काम वाले शब्द से शुरू करें (built, tested, reduced) और जहाँ हो सके, कोई संख्या लिखें।'],
    projects: ['प्रोजेक्ट', 'फ़्रेशर्स के लिए यही सबसे ज़रूरी हिस्सा है: क्या बनाया, कैसे बनाया, और नतीजा क्या रहा।'],
    skills: ['कौशल', 'सिर्फ़ वही लिखें जिनके बारे में इंटरव्यू में बात कर सकें।'],
    achievements: ['उपलब्धियाँ और प्रमाणपत्र', 'हर पंक्ति में एक: पुरस्कार, प्रमाणपत्र, प्रतियोगिताएँ, ज़िम्मेदारियाँ।'],
  },
  addLabels: { education: 'शिक्षा जोड़ें', experience: 'अनुभव जोड़ें', projects: 'प्रोजेक्ट जोड़ें', skills: 'कौशल समूह जोड़ें' },
  fields: {
    name: 'पूरा नाम', headline: 'एक पंक्ति में परिचय', email: 'ईमेल', phone: 'फ़ोन', location: 'शहर', linkedin: 'LinkedIn', github: 'GitHub', website: 'वेबसाइट या portfolio',
    degree: 'डिग्री या कक्षा', school: 'कॉलेज या स्कूल', start: 'कब से', end: 'कब तक', score: 'CGPA या प्रतिशत', points: 'विवरण (हर पंक्ति में एक बात)',
    role: 'पद', org: 'कंपनी या लैब', pname: 'प्रोजेक्ट का नाम', tools: 'इस्तेमाल किए tools', link: 'लिंक (GitHub, demo)',
    group: 'समूह (जैसे Programming)', items: 'कौशल, comma से अलग',
  },
} : {
  importBtn: 'Import my resume', reading: 'Reading your file…', imported: 'Filled in from your resume. Check every box: automatic reading is never perfect, especially for two-column layouts.', undo: 'Undo',
  importError: "That file couldn't be read. Choose a PDF, a Word .docx or a .txt file. Save an old .doc file as .docx or PDF first.", importEmpty: 'No text was found in that file. A scanned PDF (a photo of paper) has no text to read; try the Word or text version.',
  template: 'Design', templates: { classic: 'Classic', modern: 'Modern', elegant: 'Elegant' },
  edit: 'Edit', preview: 'Preview', download: 'Download PDF', example: 'Fill with an example', save: 'Save to a file', open: 'Open a saved file',
  clear: 'Start over', clearConfirm: 'Tap again to clear everything', size: 'Text size', normal: 'Normal', compact: 'Compact',
  headLang: 'Headings', credit: 'Add a small line at the bottom: "Made with kotaquantumvalley.in"',
  fit1: 'Fits on one page',
  printHint: 'In the print window, choose "Save as PDF" as the printer.',
  openError: "That file couldn't be read. Choose a .json file saved from this page.",
  add: 'Add', remove: 'Remove', up: 'Move up', down: 'Move down', tapToAdd: 'Tap to add:',
  sections: {
    basics: ['Your details', ''],
    summary: ['Summary', "Two or three lines: who you are, what you're good at, and what you want next."],
    education: ['Education', 'Most recent first.'],
    experience: ['Internships and experience', 'Start each line with an action word (built, tested, reduced) and add a number wherever you can.'],
    projects: ['Projects', 'For freshers, this is the most important section: what you built, how, and what happened.'],
    skills: ['Skills', 'List only what you could talk about in an interview.'],
    achievements: ['Achievements and certifications', 'One per line: awards, certificates, competitions, positions of responsibility.'],
  },
  addLabels: { education: 'Add education', experience: 'Add experience', projects: 'Add a project', skills: 'Add a skill group' },
  fields: {
    name: 'Full name', headline: 'One-line introduction', email: 'Email', phone: 'Phone', location: 'City', linkedin: 'LinkedIn', github: 'GitHub', website: 'Website or portfolio',
    degree: 'Degree or class', school: 'College or school', start: 'From', end: 'To', score: 'CGPA or percentage', points: 'Details (one point per line)',
    role: 'Role', org: 'Company or lab', pname: 'Project name', tools: 'Tools used', link: 'Link (GitHub, demo)',
    group: 'Group (e.g. Programming)', items: 'Skills, separated by commas',
  },
};
const fitWord = hi ? 'hi' : 'en';
---
<section class="article rm-page">
  <div class="wrap">
    <div class="rm-intro" data-pagefind-body>
      <p class="eyebrow">{ui.eyebrow}</p>
      <h1>{ui.h1}</h1>
      <p class="desc">{ui.sub}</p>
      <p class="rm-privacy"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M7 11V8a5 5 0 0 1 10 0v3" fill="none" stroke="currentColor" stroke-width="2"/><rect x="5" y="11" width="14" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2"/></svg>{ui.privacy}</p>
      <p class="rm-note">{ui.importNote}</p>
      {ui.contentNote && <p class="rm-note">{ui.contentNote}</p>}
    </div>

    <div class="rm" id="rm" data-view="edit" data-lang={fitWord}>
      <div class="rm-toolbar">
        <button type="button" class="btn btn-primary btn-sm" data-act="print">{S.download}</button>
        <button type="button" class="btn btn-ghost btn-sm rm-import" data-act="import">{S.importBtn}</button>
        <button type="button" class="btn btn-ghost btn-sm" data-act="example">{S.example}</button>
        <button type="button" class="btn btn-ghost btn-sm" data-act="save">{S.save}</button>
        <button type="button" class="btn btn-ghost btn-sm" data-act="open">{S.open}</button>
        <button type="button" class="btn btn-ghost btn-sm rm-danger" data-act="clear">{S.clear}</button>
        <input type="file" accept=".json,application/json" hidden data-file />
        <input type="file" accept=".pdf,.docx,.txt,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document,text/plain" hidden data-import />
      </div>
      <div class="rm-notice" data-notice hidden><span data-notice-text></span><button type="button" class="btn btn-ghost btn-sm" data-undo hidden>{S.undo}</button></div>

      <div class="rm-tabs" role="tablist">
        <button type="button" role="tab" aria-selected="true" data-tab="edit">{S.edit}</button>
        <button type="button" role="tab" aria-selected="false" data-tab="preview">{S.preview}</button>
      </div>

      <div class="rm-cols">
        <form class="rm-form" data-form autocomplete="on" onsubmit="return false"></form>

        <div class="rm-preview">
          <div class="rm-tpl" role="group" aria-label={S.template}>
            {Object.entries(S.templates).map(([k, label]) => <button type="button" data-tpl={k} aria-pressed={k === 'classic' ? 'true' : 'false'}><span class={`tpl-ic tpl-${k}`} aria-hidden="true"><i></i><i></i><i></i></span>{label}</button>)}
          </div>
          <div class="rm-status">
            <span class="rm-fit" data-fit></span>
            <label class="rm-inline">{S.size}
              <select data-setting="size"><option value="normal">{S.normal}</option><option value="compact">{S.compact}</option></select>
            </label>
            <label class="rm-inline">{S.headLang}
              <select data-setting="headLang"><option value="en">English</option><option value="hi">हिन्दी</option></select>
            </label>
          </div>
          <div class="rm-stage" data-stage>
            <div class="rm-paper" id="rm-paper" data-paper></div>
          </div>
          <label class="rm-check"><input type="checkbox" data-setting="credit" /> {S.credit}</label>
          <p class="rm-hint">{S.printHint}</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script define:vars={{ S, LANG: fitWord }}>
(() => {
  const KEY = 'kqv-resume-v1';
  const root = document.getElementById('rm');
  const form = root.querySelector('[data-form]');
  const paper = root.querySelector('[data-paper]');
  const stage = root.querySelector('[data-stage]');
  const fitEl = root.querySelector('[data-fit]');
  const fileIn = root.querySelector('[data-file]');
  const F = S.fields;
  const fitN = (n) => LANG === 'hi'
    ? `${n} पेज। फ़्रेशर्स के लिए एक पेज सबसे अच्छा है: "छोटा" आकार चुनें या कुछ पंक्तियाँ घटाएँ।`
    : `${n} pages. For freshers, one page is best: choose "Compact" or cut a few lines.`;

  const HEAD = {
    en: { contact: 'Contact', summary: 'Summary', education: 'Education', experience: 'Experience', projects: 'Projects', skills: 'Skills', achievements: 'Achievements and certifications' },
    hi: { contact: 'संपर्क', summary: 'सारांश', education: 'शिक्षा', experience: 'अनुभव', projects: 'प्रोजेक्ट', skills: 'कौशल', achievements: 'उपलब्धियाँ और प्रमाणपत्र' },
  };
  const LISTS = {
    education: ['degree', 'school', 'start', 'end', 'score', 'points'],
    experience: ['role', 'org', 'location', 'start', 'end', 'points'],
    projects: ['name', 'tools', 'link', 'points'],
    skills: ['group', 'items'],
  };
  const CHIPS = {
    Programming: ['C', 'C++', 'Python', 'Embedded C', 'Java', 'JavaScript', 'MATLAB', 'SQL'],
    Quantum: ['Qiskit', 'Quantum circuits', 'Linear algebra', 'NumPy'],
    Electronics: ['Arduino', 'ESP32', 'STM32', 'UART/SPI/I2C', 'FreeRTOS', 'PCB design', 'Oscilloscope'],
    Tools: ['Git', 'Linux', 'VS Code', 'Jupyter', 'LaTeX', 'Excel'],
  };

  const blank = () => ({
    basics: { name: '', headline: '', email: '', phone: '', location: '', linkedin: '', github: '', website: '' },
    summary: '',
    education: [{ degree: '', school: '', start: '', end: '', score: '', points: '' }],
    experience: [], projects: [], skills: [], achievements: '',
    settings: { size: 'normal', headLang: 'en', credit: true, template: 'classic' },
  });

  const example = () => ({
    basics: {
      name: 'Riya Sharma', headline: 'B.Tech ECE student | Embedded systems and quantum computing',
      email: 'riya.sharma@example.com', phone: '+91 98765 43210', location: 'Kota, Rajasthan',
      linkedin: 'linkedin.com/in/riya-sharma-example', github: 'github.com/riya-example', website: '',
    },
    summary: 'Final-year electronics student who enjoys building things that talk to hardware. I write embedded C for microcontrollers and Python for quantum circuits, and I completed all 50 lessons of the Kota Quantum Valley course. Looking for an internship in embedded or quantum control engineering.',
    education: [
      { degree: 'B.Tech, Electronics and Communication Engineering', school: 'Example Institute of Technology, Kota', start: '2022', end: '2026', score: 'CGPA 8.4/10', points: '' },
      { degree: 'Class XII (PCM), RBSE', school: 'Example Senior Secondary School, Kota', start: '', end: '2022', score: '91%', points: '' },
    ],
    experience: [
      { role: 'Firmware intern', org: 'Example Electronics Pvt Ltd', location: 'Jaipur', start: 'May 2025', end: 'Jul 2025',
        points: 'Wrote a UART driver and command parser in embedded C for an STM32 sensor board\nCut boot time from 1.8 s to 0.6 s by moving start-up checks to a background task\nWrote test scripts in Python that the team now runs before every release' },
    ],
    projects: [
      { name: 'Quantum teleportation in Qiskit', tools: 'Python, Qiskit, Qiskit Aer', link: 'github.com/riya-example/teleport',
        points: 'Teleported random qubit states with mid-circuit measurement and feed-forward, reaching fidelity 1.000 in simulation\nMeasured how fidelity falls with noisy entangled pairs and matched the (2F + 1)/3 formula' },
      { name: 'Smart energy meter on ESP32', tools: 'ESP32, C, FreeRTOS, MQTT', link: '',
        points: 'Built a meter that measures voltage and current and sends readings every 10 s over Wi-Fi\nAdded a watchdog and offline buffering so no readings are lost when Wi-Fi drops' },
    ],
    skills: [
      { group: 'Programming', items: 'C, Embedded C, Python, MATLAB' },
      { group: 'Quantum', items: 'Qiskit, Quantum circuits, Linear algebra, NumPy' },
      { group: 'Electronics', items: 'STM32, ESP32, UART/SPI/I2C, FreeRTOS, Oscilloscope' },
      { group: 'Tools', items: 'Git, Linux, VS Code, Jupyter' },
    ],
    achievements: 'Completed Kota Quantum Valley Course 1: 50 lessons, from bits to real quantum hardware\nRunner-up, college hardware hackathon (2024), out of 40 teams\nTechnical lead, college electronics club (2024–25)',
    settings: { size: 'normal', headLang: 'en', credit: true, template: 'classic' },
  });

  // ---------- state and storage ----------
  const merge = (d) => {
    const b = blank();
    if (!d || typeof d !== 'object') return b;
    const out = { ...b, ...d, basics: { ...b.basics, ...(d.basics || {}) }, settings: { ...b.settings, ...(d.settings || {}) } };
    for (const k of Object.keys(LISTS)) out[k] = Array.isArray(d[k]) ? d[k].map((it) => Object.fromEntries(LISTS[k].map((f) => [f, String((it && it[f]) ?? '')]))) : b[k];
    out.summary = String(out.summary || ''); out.achievements = String(out.achievements || '');
    return out;
  };
  let state = blank();
  try { const saved = localStorage.getItem(KEY); if (saved) state = merge(JSON.parse(saved)); } catch (e) { /* storage unavailable: start blank */ }
  let saveTimer;
  const saveNow = () => { clearTimeout(saveTimer); try { localStorage.setItem(KEY, JSON.stringify(state)); } catch (e) {} };
  const persist = () => { clearTimeout(saveTimer); saveTimer = setTimeout(saveNow, 300); };
  window.addEventListener('pagehide', saveNow);
  document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') saveNow(); });

  // ---------- helpers ----------
  const esc = (s) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
  const lines = (t) => String(t || '').split('\n').map((s) => s.replace(/^\s*[-•*·]\s*/, '').trim()).filter(Boolean);
  const bare = (u) => String(u).trim().replace(/^https?:\/\//i, '').replace(/^www\./i, '').replace(/\/$/, '');
  const href = (u) => (/^https?:\/\//i.test(u.trim()) ? u.trim() : 'https://' + u.trim());
  const getPath = (p) => p.split('.').reduce((o, k) => (o == null ? o : o[k]), state);
  const setPath = (p, v) => { const ks = p.split('.'); const last = ks.pop(); ks.reduce((o, k) => o[k], state)[last] = v; };

  // ---------- the form ----------
  const field = (path, label, opts = {}) => {
    const id = 'rm-' + path.replace(/\./g, '-');
    const v = esc(getPath(path) ?? '');
    const ph = opts.ph ? ` placeholder="${esc(opts.ph)}"` : '';
    const ac = opts.ac ? ` autocomplete="${opts.ac}"` : '';
    const type = opts.type || 'text';
    const input = opts.area
      ? `<textarea id="${id}" data-path="${path}" rows="${opts.rows || 3}"${ph}>${v}</textarea>`
      : `<input id="${id}" type="${type}" data-path="${path}" value="${v}"${ph}${ac} />`;
    return `<label class="rm-field${opts.wide ? ' rm-wide' : ''}" for="${id}"><span>${esc(label)}</span>${input}</label>`;
  };
  const sectionHead = (key) => {
    const [title, hint] = S.sections[key];
    return `<summary><span class="rm-sec-title">${esc(title)}</span></summary>${hint ? `<p class="rm-sec-hint">${esc(hint)}</p>` : ''}`;
  };
  const itemTools = (key, i, n) => `<div class="rm-item-tools">
      <button type="button" data-move="${key}.${i}.-1" ${i === 0 ? 'disabled' : ''} aria-label="${esc(S.up)}">↑</button>
      <button type="button" data-move="${key}.${i}.1" ${i === n - 1 ? 'disabled' : ''} aria-label="${esc(S.down)}">↓</button>
      <button type="button" data-remove="${key}.${i}">${esc(S.remove)}</button></div>`;

  const openState = {};
  const renderForm = () => {
    const b = 'basics.';
    const isOpen = (k, dflt) => (openState[k] ?? dflt) ? ' open' : '';
    let h = `<details class="rm-sec" data-sec="basics"${isOpen('basics', true)}>${sectionHead('basics')}<div class="rm-grid">
      ${field(b + 'name', F.name, { ac: 'name', wide: true })}
      ${field(b + 'headline', F.headline, { wide: true, ph: 'B.Tech ECE student | Embedded systems and quantum computing' })}
      ${field(b + 'email', F.email, { type: 'email', ac: 'email' })}
      ${field(b + 'phone', F.phone, { type: 'tel', ac: 'tel' })}
      ${field(b + 'location', F.location, { ph: 'Kota, Rajasthan' })}
      ${field(b + 'linkedin', F.linkedin, { ph: 'linkedin.com/in/your-name' })}
      ${field(b + 'github', F.github, { ph: 'github.com/your-name' })}
      ${field(b + 'website', F.website)}
    </div></details>`;
    h += `<details class="rm-sec" data-sec="summary"${isOpen('summary', true)}>${sectionHead('summary')}${field('summary', S.sections.summary[0], { area: true, rows: 4, wide: true })}</details>`;

    const listSection = (key, fieldsHtml) => {
      const arr = state[key];
      let s = `<details class="rm-sec" data-sec="${key}"${isOpen(key, key === 'education' || arr.length > 0)}>${sectionHead(key)}`;
      arr.forEach((_, i) => { s += `<div class="rm-item">${itemTools(key, i, arr.length)}<div class="rm-grid">${fieldsHtml(i)}</div></div>`; });
      if (key === 'skills') {
        s += `<div class="rm-chips"><span>${esc(S.tapToAdd)}</span>${Object.entries(CHIPS).map(([g, xs]) =>
          `<div class="rm-chip-row"><b>${esc(g)}</b>${xs.map((x) => `<button type="button" class="rm-chip" data-chip="${esc(g)}|${esc(x)}">${esc(x)}</button>`).join('')}</div>`).join('')}</div>`;
      }
      return s + `<button type="button" class="btn btn-ghost btn-sm rm-add" data-add="${key}">+ ${esc(S.addLabels[key])}</button></details>`;
    };
    h += listSection('education', (i) => `${field(`education.${i}.degree`, F.degree, { wide: true })}${field(`education.${i}.school`, F.school, { wide: true })}
      ${field(`education.${i}.start`, F.start, { ph: '2022' })}${field(`education.${i}.end`, F.end, { ph: '2026' })}
      ${field(`education.${i}.score`, F.score, { ph: 'CGPA 8.4/10' })}${field(`education.${i}.points`, F.points, { area: true, rows: 2, wide: true })}`);
    h += listSection('experience', (i) => `${field(`experience.${i}.role`, F.role)}${field(`experience.${i}.org`, F.org)}
      ${field(`experience.${i}.location`, F.location)}${field(`experience.${i}.start`, F.start, { ph: 'May 2025' })}${field(`experience.${i}.end`, F.end, { ph: 'Jul 2025' })}
      ${field(`experience.${i}.points`, F.points, { area: true, rows: 4, wide: true })}`);
    h += listSection('projects', (i) => `${field(`projects.${i}.name`, F.pname, { wide: true })}${field(`projects.${i}.tools`, F.tools)}${field(`projects.${i}.link`, F.link)}
      ${field(`projects.${i}.points`, F.points, { area: true, rows: 4, wide: true })}`);
    h += listSection('skills', (i) => `${field(`skills.${i}.group`, F.group)}${field(`skills.${i}.items`, F.items, { wide: true })}`);
    h += `<details class="rm-sec" data-sec="achievements"${isOpen('achievements', state.achievements !== '')}>${sectionHead('achievements')}${field('achievements', S.sections.achievements[0], { area: true, rows: 4, wide: true })}</details>`;
    form.innerHTML = h;
    root.querySelectorAll('[data-setting]').forEach((el) => {
      const k = el.dataset.setting;
      if (el.type === 'checkbox') el.checked = !!state.settings[k]; else el.value = state.settings[k];
    });
  };

  // ---------- the resume ----------
  const renderPaper = () => {
    const H = HEAD[state.settings.headLang] || HEAD.en;
    const T = ['classic', 'modern', 'elegant'].includes(state.settings.template) ? state.settings.template : 'classic';
    const b = state.basics;
    const contact = [];
    if (b.email.trim()) contact.push(`<a href="mailto:${esc(b.email.trim())}">${esc(b.email.trim())}</a>`);
    if (b.phone.trim()) contact.push(`<a href="tel:${esc(b.phone.replace(/[^+\d]/g, ''))}">${esc(b.phone.trim())}</a>`);
    if (b.location.trim()) contact.push(esc(b.location.trim()));
    for (const k of ['linkedin', 'github', 'website']) if (b[k].trim()) contact.push(`<a href="${esc(href(b[k]))}">${esc(bare(b[k]))}</a>`);

    const ul = (t) => { const xs = lines(t); return xs.length ? `<ul>${xs.map((x) => `<li>${esc(x)}</li>`).join('')}</ul>` : ''; };
    const dates = (s, e) => [s, e].map((x) => String(x || '').trim()).filter(Boolean).join(' – ');
    const sec = (title, body) => (body.trim() ? `<section class="r-sec"><h2>${esc(title)}</h2>${body}</section>` : '');
    const filled = (o) => Object.values(o).some((v) => String(v).trim());
    // One entry: the date sits at the right of the title row (Classic, Modern) or in a left column (Elegant)
    const entry = (title, d, rest) => T === 'elegant'
      ? `<div class="r-entry r-tl"><div class="r-when">${esc(d)}</div><div class="r-what"><div class="r-row">${title}</div>${rest}</div></div>`
      : `<div class="r-entry"><div class="r-row">${title}${d ? `<span class="r-date">${esc(d)}</span>` : ''}</div>${rest}</div>`;

    const parts = {};
    parts.summary = sec(H.summary, state.summary.trim() ? `<p>${esc(state.summary.trim())}</p>` : '');
    parts.education = sec(H.education, state.education.filter(filled).map((e) => entry(`<strong>${esc(e.degree)}</strong>`, dates(e.start, e.end),
      `${e.school.trim() || e.score.trim() ? `<div class="r-row r-sub"><span>${esc(e.school)}</span>${e.score.trim() ? `<span>${esc(e.score)}</span>` : ''}</div>` : ''}${ul(e.points)}`)).join(''));
    parts.experience = sec(H.experience, state.experience.filter(filled).map((e) => {
      const who = [e.role, e.org].map((x) => x.trim()).filter(Boolean);
      return entry(`<span><strong>${esc(who[0] || '')}</strong>${who[1] ? `, ${esc(who[1])}` : ''}${e.location.trim() ? `<span class="r-muted">, ${esc(e.location)}</span>` : ''}</span>`, dates(e.start, e.end), ul(e.points));
    }).join(''));
    parts.projects = sec(H.projects, state.projects.filter(filled).map((p) => {
      const link = p.link.trim() ? `<a class="r-date" href="${esc(href(p.link))}">${esc(bare(p.link))}</a>` : '';
      const title = `<span><strong>${esc(p.name)}</strong>${p.tools.trim() ? `<span class="r-muted"> | ${esc(p.tools)}</span>` : ''}</span>`;
      return T === 'elegant' ? entry(title, '', (link ? `<p class="r-link">${link}</p>` : '') + ul(p.points)) : `<div class="r-entry"><div class="r-row">${title}${link}</div>${ul(p.points)}</div>`;
    }).join(''));
    const skillRows = state.skills.filter((x) => x.items.trim());
    parts.skills = sec(H.skills, skillRows.map((x) => T === 'modern'
      ? `<div class="r-skill">${x.group.trim() ? `<strong>${esc(x.group.trim())}</strong>` : ''}<p>${esc(x.items.split(',').map((y) => y.trim()).filter(Boolean).join(' · '))}</p></div>`
      : `<p class="r-skill">${x.group.trim() ? `<strong>${esc(x.group.trim())}:</strong> ` : ''}${esc(x.items.split(',').map((y) => y.trim()).filter(Boolean).join(', '))}</p>`).join(''));
    parts.achievements = sec(H.achievements, ul(state.achievements));

    const name = b.name.trim() ? `<h1>${esc(b.name.trim())}</h1>` : '';
    const headline = b.headline.trim() ? `<p class="r-headline">${esc(b.headline.trim())}</p>` : '';
    let h = '';
    if (T === 'modern') {
      const side = (contact.length ? `<section class="r-sec"><h2>${esc(H.contact)}</h2><ul class="r-clist">${contact.map((c) => `<li>${c}</li>`).join('')}</ul></section>` : '') + parts.skills + parts.achievements;
      const main = parts.summary + parts.experience + parts.projects + parts.education;
      if (name || headline) h += `<div class="r-head r-mhead">${name}${headline}</div>`;
      if (side || main) h += `<div class="r-mgrid">${side ? `<aside class="r-side">${side}</aside>` : ''}<div class="r-main">${main}</div></div>`;
    } else {
      if (name || headline || contact.length) h += `<div class="r-head">${name}${headline}${contact.length ? `<p class="r-contact">${contact.join('<span class="r-sep"> | </span>')}</p>` : ''}</div>`;
      h += parts.summary + parts.education + parts.experience + parts.projects + parts.skills + parts.achievements;
    }
    if (!h) h = `<p class="r-empty">${LANG === 'hi' ? 'बाईं ओर के ख़ाने भरिए। आपका रिज़्यूमे यहाँ दिखेगा।' : 'Start filling in the boxes. Your resume appears here.'}</p>`;
    if (state.settings.credit) h += `<p class="r-credit">Made with kotaquantumvalley.in</p>`;

    paper.className = `rm-paper t-${T}` + (state.settings.size === 'compact' ? ' r-compact' : '');
    paper.innerHTML = `<div class="r-body">${h}</div>`;
    root.querySelectorAll('[data-tpl]').forEach((x) => x.setAttribute('aria-pressed', String(x.dataset.tpl === T)));
    fit();
  };

  // ---------- scaling and page count ----------
  const MM = 96 / 25.4;
  const fit = () => {
    const body = paper.querySelector('.r-body');
    const pageH = 269 * MM;                                   // A4 height minus top and bottom margins
    const pages = Math.max(1, Math.ceil((body.scrollHeight - 2) / pageH));
    paper.style.minHeight = `${297 * pages}mm`;
    paper.querySelectorAll('.r-break').forEach((x) => x.remove());
    for (let k = 1; k < pages; k++) {
      const line = document.createElement('div');
      line.className = 'r-break'; line.style.top = `${14 + 269 * k}mm`;
      paper.appendChild(line);
    }
    fitEl.textContent = pages === 1 ? S.fit1 : fitN(pages);
    fitEl.classList.toggle('rm-warn', pages > 1);
    const s = Math.min(1, stage.clientWidth / paper.offsetWidth);
    paper.style.transform = `scale(${s})`;
    stage.style.height = `${paper.offsetHeight * s}px`;
  };
  new ResizeObserver(() => fit()).observe(stage);

  // ---------- events ----------
  form.addEventListener('input', (e) => {
    const p = e.target.dataset.path;
    if (!p) return;
    setPath(p, e.target.value);
    renderPaper(); persist();
  });
  form.addEventListener('toggle', (e) => { if (e.target.dataset.sec) openState[e.target.dataset.sec] = e.target.open; }, true);
  form.addEventListener('click', (e) => {
    const t = e.target.closest('button');
    if (!t) return;
    if (t.dataset.add) {
      const key = t.dataset.add;
      state[key].push(Object.fromEntries(LISTS[key].map((f) => [f, ''])));
      openState[key] = true; renderForm(); renderPaper(); persist();
      const items = form.querySelectorAll(`[data-sec="${key}"] .rm-item`);
      items[items.length - 1]?.querySelector('input, textarea')?.focus();
    } else if (t.dataset.remove) {
      const [key, i] = t.dataset.remove.split('.');
      state[key].splice(+i, 1); renderForm(); renderPaper(); persist();
    } else if (t.dataset.move) {
      const [key, i, d] = t.dataset.move.split('.');
      const a = state[key], j = +i + +d;
      if (j < 0 || j >= a.length) return;
      [a[+i], a[j]] = [a[j], a[+i]]; renderForm(); renderPaper(); persist();
    } else if (t.dataset.chip) {
      const [g, x] = t.dataset.chip.split('|');
      let row = state.skills.find((s) => s.group.trim().toLowerCase() === g.toLowerCase());
      if (!row) { row = { group: g, items: '' }; state.skills.push(row); }
      const have = row.items.split(',').map((s) => s.trim()).filter(Boolean);
      if (!have.some((s) => s.toLowerCase() === x.toLowerCase())) row.items = [...have, x].join(', ');
      openState.skills = true; renderForm(); renderPaper(); persist();
    }
  });
  root.querySelectorAll('[data-setting]').forEach((el) => el.addEventListener('change', () => {
    const k = el.dataset.setting;
    state.settings[k] = el.type === 'checkbox' ? el.checked : el.value;
    renderPaper(); persist();
  }));
  root.querySelectorAll('[data-tab]').forEach((tab) => tab.addEventListener('click', () => {
    root.dataset.view = tab.dataset.tab;
    root.querySelectorAll('[data-tab]').forEach((x) => x.setAttribute('aria-selected', String(x === tab)));
    fit();
  }));

  let clearTimer;
  root.querySelector('.rm-toolbar').addEventListener('click', (e) => {
    const t = e.target.closest('[data-act]');
    if (!t) return;
    const act = t.dataset.act;
    if (act === 'print') {
      const old = document.title;
      document.title = (state.basics.name.trim() || 'My') + ' resume';
      window.addEventListener('afterprint', () => { document.title = old; }, { once: true });
      window.print();
    } else if (act === 'example') {
      state = example(); renderForm(); renderPaper(); persist();
    } else if (act === 'save') {
      const blob = new Blob([JSON.stringify(state, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = (state.basics.name.trim() || 'my').toLowerCase().replace(/[^a-z0-9ऀ-ॿ]+/g, '-').replace(/^-|-$/g, '') + '-resume.json';
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 1000);
    } else if (act === 'open') {
      fileIn.click();
    } else if (act === 'clear') {
      if (t.dataset.armed) {
        clearTimeout(clearTimer); delete t.dataset.armed; t.textContent = S.clear;
        state = blank(); renderForm(); renderPaper(); persist();
      } else {
        t.dataset.armed = '1'; t.textContent = S.clearConfirm;
        clearTimer = setTimeout(() => { delete t.dataset.armed; t.textContent = S.clear; }, 4000);
      }
    }
  });
  fileIn.addEventListener('change', async () => {
    const f = fileIn.files && fileIn.files[0];
    if (!f) return;
    try { state = merge(JSON.parse(await f.text())); renderForm(); renderPaper(); persist(); }
    catch (err) { alert(S.openError); }
    fileIn.value = '';
  });

  root.querySelectorAll('[data-tpl]').forEach((btn) => btn.addEventListener('click', () => {
    state.settings.template = btn.dataset.tpl; renderPaper(); persist();
  }));

  // ---------- importing an existing resume (parsed by the module script below) ----------
  const notice = root.querySelector('[data-notice]');
  const noticeText = root.querySelector('[data-notice-text]');
  const undoBtn = root.querySelector('[data-undo]');
  let before = null;
  const say = (msg, undo = false) => { noticeText.textContent = msg; notice.hidden = false; undoBtn.hidden = !undo; };
  root.addEventListener('rm-import-start', () => say(S.reading));
  root.addEventListener('rm-import-error', () => say(S.importError));
  root.addEventListener('rm-import', (e) => {
    const d = e.detail.data;
    const got = merge({ ...d, settings: state.settings });
    const any = Object.values(got.basics).some((v) => v.trim()) || got.summary || got.achievements
      || ['education', 'experience', 'projects', 'skills'].some((k) => got[k].some((it) => Object.values(it).some((v) => v.trim())));
    if (!any) { say(S.importEmpty); return; }
    if (!got.education.length) got.education = blank().education;
    before = JSON.stringify(state);
    state = got;
    for (const k of ['experience', 'projects', 'skills']) openState[k] = state[k].length > 0;
    renderForm(); renderPaper(); persist();
    say(S.imported, true);
  });
  undoBtn.addEventListener('click', () => {
    if (!before) return;
    state = merge(JSON.parse(before)); before = null;
    renderForm(); renderPaper(); persist();
    notice.hidden = true;
  });

  renderForm();
  renderPaper();
})();
</script>

<script>
  // Reads an imported resume (PDF, .docx, .txt) in the browser and hands the fields to the form above.
  import { readResumeFile, parseResume } from '../scripts/resume-import.js';
  const root = document.getElementById('rm');
  const input = root?.querySelector('[data-import]') as HTMLInputElement | null;
  root?.querySelector('[data-act="import"]')?.addEventListener('click', () => input?.click());
  input?.addEventListener('change', async () => {
    const f = input.files?.[0];
    if (!f || !root) return;
    root.dispatchEvent(new CustomEvent('rm-import-start'));
    try {
      const text = await readResumeFile(f);
      root.dispatchEvent(new CustomEvent('rm-import', { detail: { data: parseResume(text) } }));
    } catch (err) {
      root.dispatchEvent(new CustomEvent('rm-import-error', { detail: String(err) }));
    }
    input.value = '';
  });
</script>

