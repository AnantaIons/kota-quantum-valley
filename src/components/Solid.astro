---
// A slowly turning wireframe shape (see src/scripts/solids.js).
// shape: tetra | cube | octa | icosa | dodeca | torus | orbital.  tone: cobalt | gold | mix (blue and gold).
const { shape = 'cube', tone = 'cobalt', size = 72, speed = 0.25, tilt = 0.5, class: cls = '' } = Astro.props;
---
<svg class={`solid solid-${tone} ${cls}`} viewBox="-50 -50 100 100" width={size} height={size} data-solid={shape} data-speed={speed} data-tilt={tilt} aria-hidden="true"></svg>

<script>
  import '../scripts/solids.js';
</script>

<style is:global>
  .solid { display: block; overflow: visible; }
  .solid line, .solid polyline { fill: none; stroke-linecap: round; stroke-linejoin: round; }
  .solid-cobalt line, .solid-cobalt polyline { stroke: #2979FF; stroke-width: 1.5; }
  .solid-cobalt { filter: drop-shadow(0 0 3px rgba(41, 121, 255, 0.75)); }
  .solid-cobalt circle { fill: #9cc4ff; }
  .solid-gold line, .solid-gold polyline { stroke: #D4AF37; stroke-width: 1.6; }
  .solid-gold { filter: drop-shadow(0 0 2px rgba(212, 175, 55, 0.6)); }
  .solid-gold circle { fill: #F6DC93; }
  .solid-green line { stroke: #39E6A0; stroke-width: 1.5; }
  .solid-green { filter: drop-shadow(0 0 3px rgba(57, 230, 160, 0.6)); }
  .solid-green circle { fill: #b8ffe2; }
  .solid-mix polyline.s-a { stroke: #2979FF; stroke-width: 1.3; }
  .solid-mix polyline.s-b { stroke: #D4AF37; stroke-width: 1.6; }
  .solid-mix { filter: drop-shadow(0 0 3px rgba(41, 121, 255, 0.6)); }
  .solid .s-core { fill: #D4AF37; filter: drop-shadow(0 0 4px #D4AF37); }
  .solid .s-e { fill: #00D4FF; filter: drop-shadow(0 0 3px #00D4FF); }
  .solid-cobalt polyline.s-a { stroke: #2979FF; stroke-width: 1.1; opacity: 0.85; }
  .solid-cobalt polyline.s-b { stroke: #00D4FF; stroke-width: 1.2; }
</style>
