---
// Lesson cards: cover slide, lesson number, summary. Roadmap is marked "Start here".
import slides from '../data/slides.json';
import { lessonLabel } from '../lib/posts.js';
import { t } from '../i18n.js';
const { lessons = [], lang = 'en' } = Astro.props;
const L = t[lang];
const count = (p) => (p.slides && slides[p.slides] ? slides[p.slides].length : 0);
---
<ol class="lesson-cards">
  {lessons.map((p) => (
    <li class={p.lesson ? 'lc' : 'lc lc-start'}>
      <a href={p.url}>
        <span class="lc-cover">
          {p.slides && <img src={`/thumbs/${p.slides}/01.webp`} alt="" width="432" height="540" loading="lazy" decoding="async" />}
          {!p.lesson && <span class="lc-flag">{L.startHere}</span>}
        </span>
        <span class="lc-body">
          <span class="lc-kicker">{lessonLabel(p, lang)}{count(p) ? <span class="lc-count">{L.slides(count(p))}</span> : null}</span>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
        </span>
      </a>
    </li>
  ))}
</ol>
