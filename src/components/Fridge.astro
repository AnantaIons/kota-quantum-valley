---
// "Inside a real quantum computer": an original SVG of a dilution refrigerator ("chandelier").
// Scrolling through the stage list moves the cold front down the plates.
const { lang = 'en', lessonHref = '/posts/superconducting-qubits-and-control-electronics/' } = Astro.props;
const hi = lang === 'hi';

const c = hi ? {
  eyebrow: 'असली हार्डवेयर',
  title: 'एक असली quantum computer के अंदर',
  lead: 'मशहूर सुनहरा "झूमर" असल में ज़्यादातर एक refrigerator है। यह एक छोटी-सी chip को परत-दर-परत लगभग 10 millikelvin तक ठंडा करता है, ताकि qubits इतने शांत रहें कि गणना कर सकें। नीचे स्क्रॉल करके इसके अंदर उतरिए।',
  temp: 'तापमान',
  caption: 'Dilution refrigerator का सरल चित्र, जैसा IBM, Google और दूसरे superconducting qubits के लिए इस्तेमाल करते हैं।',
  link: 'यह कैसे काम करता है, पाठ 38 में',
  down: 'नीचे जाते control pulses', up: 'ऊपर आते readout signals',
  stages: [
    ['कमरे का तापमान', 'Fridge के बाहर control electronics की racks सटीक microwave pulses बनाती हैं और जवाब वापस पढ़ती हैं। FPGA, firmware और RF design: यहीं embedded इंजीनियर काम करते हैं।'],
    ['पहली परत', 'एक pulse-tube cooler (gas compressor, liquid nitrogen नहीं) इस plate को ठंडा करता है। Radiation shields यहीं से लटकते हैं, और हर cable को गर्मी छोड़ने के लिए यहाँ जकड़ा जाता है।'],
    ['दूसरी परत', 'Cooler की ज़्यादा ठंडी परत। यहाँ लगे low-noise HEMT amplifiers qubits से लौटते बेहद कमज़ोर signals को बढ़ाते हैं।'],
    ['Still', 'यहाँ से dilution शुरू होता है: helium के दो isotopes के मिश्रण से helium-3 उबालकर pump किया जाता है, जिससे वह नीचे mixing chamber तक घूमता रहता है।'],
    ['Cold plate', 'Input lines पर लगे attenuators वह गर्मी और thermal noise सोख लेते हैं जो cables गर्म दुनिया से नीचे लाती हैं। आगे सिर्फ़ साफ़ pulses जाते हैं।'],
    ['Mixing chamber', 'Helium-3 के helium-4 में घुलने से गर्मी सोखी जाती है, और तापमान absolute zero से लगभग सौवाँ हिस्सा डिग्री ऊपर पहुँचता है, अंतरिक्ष (2.7 K) से सैकड़ों गुना ठंडा। Qubit chip यहीं, magnetic shielding के अंदर रहती है।'],
  ],
} : {
  eyebrow: 'Real hardware',
  title: 'Inside a real quantum computer',
  lead: 'The famous gold "chandelier" is mostly a refrigerator. It cools a small chip, stage by stage, to about 10 millikelvin, so the qubits stay quiet enough to compute. Scroll down through it.',
  temp: 'Temperature',
  caption: 'Simplified drawing of a dilution refrigerator, the kind IBM, Google and others use for superconducting qubits.',
  link: 'How it works, in Lesson 38',
  down: 'control pulses going down', up: 'readout signals coming up',
  stages: [
    ['Room temperature', 'Outside the fridge, racks of control electronics make precise microwave pulses and read the answers back. FPGAs, firmware and RF design: this is where embedded engineers work.'],
    ['First stage', 'A pulse-tube cooler (a gas compressor, no liquid nitrogen) cools this plate. Radiation shields hang from here, and every cable is clamped to shed its heat.'],
    ['Second stage', "The cooler's colder stage. Low-noise HEMT amplifiers here boost the faint signals coming back from the qubits."],
    ['Still', 'The dilution process starts here: helium-3 is boiled off a mixture of two helium isotopes and pumped away, which keeps it circulating down to the mixing chamber.'],
    ['Cold plate', 'Attenuators on the input lines soak up the heat and thermal noise that cables carry down from the warm world. Only clean pulses continue.'],
    ['Mixing chamber', 'Helium-3 crossing into helium-4 absorbs heat, reaching about a hundredth of a degree above absolute zero, hundreds of times colder than outer space (2.7 K). The qubit chip sits here, inside magnetic shielding.'],
  ],
};
const temps = [300, 50, 4, 1, 0.1, 0.01];
const tLabel = ['300 K', '50 K', '4 K', '≈ 1 K', '≈ 100 mK', '≈ 10 mK'];

// ---------- geometry of the drawing ----------
const cx = 210;
const plates = [
  { y: 74, rx: 172, t: 14 }, { y: 168, rx: 152, t: 11 }, { y: 262, rx: 134, t: 11 },
  { y: 352, rx: 118, t: 10 }, { y: 434, rx: 104, t: 10 }, { y: 512, rx: 92, t: 12 },
].map((p) => ({ ...p, ry: Math.round(p.rx * 0.2) }));
const f = (n) => Math.round(n * 10) / 10;
const sideBand = (p) => `M${f(cx - p.rx)} ${p.y} A${p.rx} ${p.ry} 0 0 0 ${f(cx + p.rx)} ${p.y} L${f(cx + p.rx)} ${p.y + p.t} A${p.rx} ${p.ry} 0 0 1 ${f(cx - p.rx)} ${p.y + p.t} Z`;

// Support rods between plates: two at the back (thin, dim), two at the front.
const rods = [];
for (let i = 0; i < plates.length - 1; i++) {
  const a = plates[i], b = plates[i + 1];
  for (const [k, front] of [[-0.78, true], [0.78, true], [-0.5, false], [0.5, false]]) {
    const x = f(cx + k * b.rx);
    const y1 = a.y + a.t + (front ? 0.55 : -0.75) * a.ry * 0.9;
    const y2 = b.y + (front ? 0.62 : -0.8) * b.ry;
    rods.push({ x, y1: f(y1), y2: f(y2), front });
  }
}

// Coaxial cables: continuous from the top flange to the mixing chamber, gently swaying between plates.
const cableX = [-0.62, -0.42, -0.2, 0.02, 0.24, 0.44, 0.64];
const cables = cableX.map((k, j) => {
  let d = '';
  let x = cx + k * plates[0].rx * 0.55;
  let y = 40;
  d += `M${f(x)} ${y}`;
  plates.forEach((p, i) => {
    const xn = cx + k * p.rx * 0.82;
    const yn = p.y + p.t * 0.5;
    const sway = (j % 2 ? 1 : -1) * (i % 2 ? 9 : -7);
    d += ` C${f(x + sway)} ${f(y + (yn - y) * 0.45)} ${f(xn - sway)} ${f(y + (yn - y) * 0.6)} ${f(xn)} ${f(yn)}`;
    x = xn; y = yn;
  });
  const last = plates[plates.length - 1];
  const xin = cx + k * 26;
  d += ` C${f(x)} ${f(y + 26)} ${f(xin)} ${f(y + 18)} ${f(xin)} ${f(last.y + last.t + 30)}`;
  return { d, up: j === 1 || j === 5, delay: (j * 0.43).toFixed(2) };
});
// Attenuator blocks on input lines just below the 4 K, cold plate and mixing chamber plates.
const atten = [];
cables.forEach((cb, j) => {
  if (cb.up) return;
  for (const i of [2, 4]) {
    const p = plates[i];
    const x = cx + cableX[j] * plates[i + 1].rx * 0.82 * 0.98 + (cableX[j] < 0 ? 2 : -2);
    atten.push({ x: f(x - 3.5), y: p.y + p.t + 14 });
  }
});
const mxc = plates[5];
const can = { x: cx - 36, y: mxc.y + mxc.t + 6, w: 72, h: 84 };
---
<section class="block fridge" data-fridge>
  <div class="wrap">
    <div class="fridge-grid">
      <div class="fridge-copy">
        <p class="eyebrow">{c.eyebrow}</p>
        <h2>{c.title}</h2>
        <p class="lead">{c.lead}</p>
        <ol class="fridge-stages">
          {c.stages.map(([name, text], i) => (
            <li data-stage={i} class={i === 0 ? 'on' : ''}>
              <span class="fs-t">{tLabel[i]}</span>
              <h3>{name}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
        <a class="btn btn-ghost" href={lessonHref}>{c.link}</a>
      </div>

      <figure class="fridge-visual">
        <div class="fridge-temp" aria-live="polite">
          <span>{c.temp}</span>
          <strong data-fridge-temp>300 K</strong>
        </div>
        <svg viewBox="0 0 480 640" role="img" aria-label={c.caption} data-fridge-svg data-active="0">
          <defs>
            <linearGradient id="fg-top" x1="0" x2="1">
              <stop offset="0" stop-color="#8a6526" /><stop offset="0.35" stop-color="#f6dc93" /><stop offset="0.6" stop-color="#d9ac52" /><stop offset="1" stop-color="#7a5620" />
            </linearGradient>
            <linearGradient id="fg-side" x1="0" x2="1">
              <stop offset="0" stop-color="#5a3f14" /><stop offset="0.4" stop-color="#c79a45" /><stop offset="0.7" stop-color="#a87b2e" /><stop offset="1" stop-color="#4d3510" />
            </linearGradient>
            <linearGradient id="fg-can" x1="0" x2="1">
              <stop offset="0" stop-color="#2a2f45" /><stop offset="0.45" stop-color="#7c86a6" /><stop offset="1" stop-color="#1e2236" />
            </linearGradient>
            <radialGradient id="fg-cold" cx="0.5" cy="0.5" r="0.5">
              <stop offset="0" stop-color="#2979FF" stop-opacity="0.95" /><stop offset="1" stop-color="#0047AB" stop-opacity="0" />
            </radialGradient>
            <filter id="fg-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6" /></filter>
          </defs>

          <!-- pulse-tube head and top flange -->
          <rect x={cx - 26} y="6" width="52" height="40" rx="6" fill="url(#fg-side)" stroke="#3b2a0e" />
          <rect x={cx - 60} y="22" width="18" height="30" rx="3" fill="url(#fg-side)" stroke="#3b2a0e" opacity="0.8" />
          <rect x={cx + 44} y="26" width="14" height="26" rx="3" fill="url(#fg-side)" stroke="#3b2a0e" opacity="0.8" />

          <g class="fr-rods-back">
            {rods.filter((r) => !r.front).map((r) => <line x1={r.x} y1={r.y1} x2={r.x} y2={r.y2} />)}
          </g>
          <g class="fr-cables">
            {cables.map((cb) => <path d={cb.d} class={cb.up ? 'up' : ''} />)}
          </g>
          <g class="fr-pulses" aria-hidden="true">
            {cables.map((cb) => <path d={cb.d} pathLength="100" class={cb.up ? 'up' : 'down'} style={`animation-delay: -${cb.delay}s`} />)}
          </g>
          <g class="fr-atten">
            {atten.map((a) => <rect x={a.x} y={a.y} width="7" height="12" rx="1.5" />)}
          </g>
          <g class="fr-rods-front">
            {rods.filter((r) => r.front).map((r) => <line x1={r.x} y1={r.y1} x2={r.x} y2={r.y2} />)}
          </g>

          {plates.map((p, i) => (
            <g class="fr-plate" data-plate={i}>
              <ellipse class="fr-halo" cx={cx} cy={p.y + 4} rx={p.rx + 10} ry={p.ry + 10} fill="url(#fg-cold)" filter="url(#fg-blur)" />
              <path d={sideBand(p)} fill="url(#fg-side)" stroke="#3b2a0e" stroke-width="1" />
              <ellipse cx={cx} cy={p.y} rx={p.rx} ry={p.ry} fill="url(#fg-top)" stroke="#3b2a0e" stroke-width="1" />
              <ellipse class="fr-frost" cx={cx} cy={p.y} rx={p.rx - 3} ry={p.ry - 2} />
              <line class="fr-lead" x1={cx + p.rx + 6} y1={p.y + 4} x2={cx + p.rx + 22} y2={p.y + 4} />
              <text class="fr-label" x={cx + p.rx + 26} y={p.y + 8}>{tLabel[i].replace('≈ ', '')}</text>
            </g>
          ))}

          <!-- shielded sample can with the qubit chip -->
          <g class="fr-can">
            <path d={`M${can.x} ${can.y} h${can.w} v${can.h - 14} a14 14 0 0 1 -14 14 h${-(can.w - 28)} a14 14 0 0 1 -14 -14 Z`} fill="url(#fg-can)" stroke="#11152a" />
            <rect class="fr-window" x={cx - 18} y={can.y + 30} width="36" height="36" rx="4" />
            <g class="fr-chip">
              <rect x={cx - 11} y={can.y + 37} width="22" height="22" rx="2" />
              {[0, 1, 2, 3].map((k) => <circle cx={cx - 5.5 + (k % 2) * 11} cy={can.y + 42.5 + Math.floor(k / 2) * 11} r="2.4" />)}
            </g>
          </g>

          <g class="fr-key" transform="translate(268 584)">
            <line x1="0" y1="0" x2="22" y2="0" class="down" /><text x="30" y="4">{c.down}</text>
            <line x1="0" y1="20" x2="22" y2="20" class="up" /><text x="30" y="24">{c.up}</text>
          </g>
        </svg>
        <figcaption>{c.caption}</figcaption>
      </figure>
    </div>
  </div>
</section>

<script define:vars={{ temps, finals: ['300 K', '50 K', '4 K', '1 K', '100 mK', '10 mK'] }}>
(() => {
  const root = document.querySelector('[data-fridge]');
  if (!root) return;
  const svg = root.querySelector('[data-fridge-svg]');
  const items = [...root.querySelectorAll('[data-stage]')];
  const out = root.querySelector('[data-fridge-temp]');
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const fmt = (T) => (T >= 1 ? `${T >= 10 ? Math.round(T) : T.toFixed(1)} K` : `${T >= 0.1 ? Math.round(T * 1000) : (T * 1000).toFixed(T * 1000 < 10 ? 1 : 0)} mK`);
  let current = 0, shown = temps[0], raf = 0;

  const setStage = (i) => {
    if (i === current) return;
    current = i;
    svg.dataset.active = String(i);
    items.forEach((li, k) => li.classList.toggle('on', k === i));
    svg.querySelectorAll('[data-plate]').forEach((g) => g.classList.toggle('cold', +g.dataset.plate <= i && i > 0));
    svg.querySelectorAll('[data-plate]').forEach((g) => g.classList.toggle('here', +g.dataset.plate === i));
    svg.classList.toggle('at-chip', i === temps.length - 1);
    const from = Math.log10(shown), to = Math.log10(temps[i]);
    cancelAnimationFrame(raf);
    if (still) { shown = temps[i]; out.textContent = finals[i]; return; }
    const t0 = performance.now(), dur = 700;
    const step = (now) => {
      const p = Math.min(1, (now - t0) / dur), e = 1 - Math.pow(1 - p, 3);
      shown = Math.pow(10, from + (to - from) * e);
      out.textContent = p === 1 ? finals[i] : fmt(shown);
      if (p < 1) raf = requestAnimationFrame(step);
    };
    raf = requestAnimationFrame(step);
  };
  svg.querySelector('[data-plate="0"]').classList.add('here');

  // The stage whose text crosses the middle of the screen is the active one.
  const io = new IntersectionObserver((entries) => {
    for (const en of entries) if (en.isIntersecting) setStage(+en.target.dataset.stage);
  }, { rootMargin: '-45% 0px -45% 0px' });
  items.forEach((li) => io.observe(li));

  // Only animate the cable pulses while the drawing is on screen.
  new IntersectionObserver(([en]) => svg.classList.toggle('live', en.isIntersecting)).observe(svg);
})();
</script>

<style is:global>
  .fridge { position: relative; }
  .fridge-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: 56px; align-items: start; }
  .fridge-copy h2 { margin-top: 0; }
  .fridge-copy .lead { color: var(--text-2); max-width: 52ch; }
  .fridge-temp { position: absolute; left: 0; top: 4px; z-index: 2; display: flex; flex-direction: column; gap: 2px; padding: 12px 16px; border: 1px solid var(--border); border-radius: var(--r-md); background: rgba(3, 5, 16, 0.75); backdrop-filter: blur(8px); min-width: 150px; }
  .fridge-temp span { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-3); }
  .fridge-temp strong { font-family: var(--font-head); font-size: 2.2rem; line-height: 1.05; letter-spacing: -0.02em; color: var(--cobalt-text); font-variant-numeric: tabular-nums; }
  .fridge-stages { list-style: none; margin: 18px 0 28px; padding: 0 0 22vh; }
  .fridge-stages li { min-height: 34vh; padding: 22px 0 22px 22px; border-left: 2px solid var(--border); transition: border-color 0.3s, opacity 0.3s; opacity: 0.45; display: flex; flex-direction: column; justify-content: center; }
  .fridge-stages li.on { border-left-color: var(--cobalt-hi); opacity: 1; }
  .fridge-stages .fs-t { font-family: var(--font-mono); font-size: 0.8rem; color: var(--cobalt-text); }
  .fridge-stages h3 { margin: 4px 0 6px; font-size: 1.25rem; }
  .fridge-stages p { margin: 0; color: var(--text-2); max-width: 48ch; }
  .fridge-visual { margin: 0; position: sticky; top: 84px; }
  .fridge-visual svg { width: 100%; height: auto; max-height: calc(100vh - 140px); display: block; margin: 0 auto; overflow: visible; }
  .fridge-visual figcaption { font-size: 0.82rem; color: var(--text-3); text-align: center; margin-top: 8px; }

  .fr-rods-back line { stroke: #6b5a33; stroke-width: 3; opacity: 0.55; }
  .fr-rods-front line { stroke: url(#fg-side); stroke: #b98d3c; stroke-width: 4; }
  .fr-cables path { fill: none; stroke: #8b7448; stroke-width: 2; opacity: 0.9; }
  .fr-cables path.up { stroke: #17738a; }
  .fr-pulses path { fill: none; stroke-width: 2.6; stroke-linecap: round; stroke-dasharray: 3 97; stroke-dashoffset: 0; opacity: 0; }
  .fr-pulses path.down { stroke: #fff1c2; }
  .fr-pulses path.up { stroke: var(--sci); }
  .live .fr-pulses path { opacity: 1; animation: fr-pulse 2.8s linear infinite; }
  .live .fr-pulses path.up { animation-direction: reverse; animation-duration: 3.4s; }
  @keyframes fr-pulse { from { stroke-dashoffset: 0; } to { stroke-dashoffset: -100; } }
  .fr-atten rect { fill: #4b5170; stroke: #1b1f33; }
  .fr-halo { opacity: 0; transition: opacity 0.5s; }
  .fr-plate.here .fr-halo { opacity: 0.55; }
  .fr-frost { fill: none; stroke: #8DB4FF; stroke-width: 2; opacity: 0; transition: opacity 0.5s; }
  .fr-plate.cold .fr-frost { opacity: 0.55; }
  .fr-plate.here .fr-frost { opacity: 1; }
  .fr-lead { stroke: var(--text-3); stroke-width: 1; }
  .fr-label { font-family: var(--font-mono); font-size: 15px; fill: var(--text-2); transition: fill 0.3s; }
  .fr-plate.here .fr-label { fill: var(--cobalt-text); font-weight: 600; }
  .fr-window { fill: #05070f; stroke: #8b93b3; }
  .fr-chip rect { fill: #1d2b4f; stroke: #e6c36a; stroke-width: 1; }
  .fr-chip circle { fill: #e6c36a; opacity: 0.5; transition: opacity 0.4s, filter 0.4s; }
  .at-chip .fr-chip circle { opacity: 1; filter: drop-shadow(0 0 4px #e6c36a); }
  .live.at-chip .fr-chip circle { animation: fr-qubit 1.8s ease-in-out infinite; }
  .live.at-chip .fr-chip circle:nth-of-type(2) { animation-delay: 0.45s; }
  .live.at-chip .fr-chip circle:nth-of-type(3) { animation-delay: 0.9s; }
  .live.at-chip .fr-chip circle:nth-of-type(4) { animation-delay: 1.35s; }
  @keyframes fr-qubit { 50% { opacity: 0.35; } }
  .fr-key line { stroke-width: 3; stroke-linecap: round; }
  .fr-key line.down { stroke: #fff1c2; }
  .fr-key line.up { stroke: var(--sci); }
  .fr-key text { font-family: var(--font-mono); font-size: 13px; fill: var(--text-3); }

  @media (max-width: 900px) {
    .fridge-grid { grid-template-columns: 1fr; gap: 0; }
    .fridge-visual { order: -1; top: 64px; z-index: 3; background: linear-gradient(var(--space) 82%, transparent); padding: 8px 0 18px; }
    .fridge-visual svg { max-height: 44vh; }
    .fridge-visual figcaption { display: none; }
    .fridge-temp { top: 8px; padding: 8px 12px; min-width: 0; }
    .fridge-temp strong { font-size: 1.6rem; }
    .fridge-stages { padding-bottom: 8vh; }
    .fridge-stages li { min-height: 26vh; }
  }
</style>
