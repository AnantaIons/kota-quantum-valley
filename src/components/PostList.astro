---
import { formatDate } from '../lib/posts.js';
import { t } from '../i18n.js';
const { posts = [], lang = 'en', empty } = Astro.props;
const L = t[lang];
const labels = { journey: L.journeyTag, explainer: L.explainerTag };
---
{posts.length === 0 ? (
  <p class="meta">{empty ?? L.soon}</p>
) : (
  <ul class="post-list">
    {posts.map((p) => (
      <li class="post-item">
        <a href={p.url}>
          <span class="tag">{labels[p.category] ?? p.category}</span>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <span class="meta">{p.day ? `${L.day(p.day)}, ` : ''}{formatDate(p.date, lang)}</span>
        </a>
      </li>
    ))}
  </ul>
)}
