---
// Home-page panel: a row of sketch portraits that opens the Great Minds page.
import MindsArt from './MindsArt.astro';
import { minds } from '../data/minds.js';
import art from '../data/minds-art.json';

const { lang = 'en' } = Astro.props;
const hi = lang === 'hi';
const href = hi ? '/hi/great-minds/' : '/great-minds/';
const pick = ['ramanujan', 'einstein', 'raman', 'curie', 'kalam', 'feynman', 'sn-bose', 'newton'].map((s) => minds.find((m) => m.slug === s));
---
<MindsArt />
<section class="block minds-strip">
  <div class="wrap">
    <div class="section-head">
      <h2>{hi ? 'महान विचारक' : 'Great minds'}</h2>
      <p>{hi
        ? 'आर्यभट से कलाम तक सोलह लोग: उन्होंने क्या दिया, वे कैसे सोचते थे, और एक आदत जो आप आज अपना सकते हैं।'
        : 'Sixteen people from Aryabhata to Kalam: what they gave us, how they thought, and one habit you can copy today.'}</p>
    </div>
    <ul class="ms-row">
      {pick.map((m) => (
        <li>
          <a href={`${href}#${m.slug}`}>
            <svg class="mind-art" viewBox="0 0 200 220" aria-hidden="true"><Fragment set:html={art[m.slug]} /></svg>
            <span class="ms-name">{m[lang].name}</span>
            <span class="ms-years">{m.years}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="ms-all"><a class="btn btn-ghost" href={href}>{hi ? 'सभी सोलह देखें' : 'Meet all sixteen'}</a></p>
  </div>
</section>

<style is:global>
  .ms-row { list-style: none; margin: 0; padding: 4px 0 12px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(128px, 1fr); gap: 14px; overflow-x: auto; scroll-snap-type: x mandatory; }
  .ms-row li { scroll-snap-align: start; min-width: 0; display: flex; }
  .ms-row a { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 2px; padding: 10px 8px 14px; border: 1px solid var(--border); border-radius: var(--r-md); background: rgba(11, 16, 38, 0.6); text-decoration: none; color: var(--text); transition: border-color 0.2s, transform 0.2s; }
  .ms-row a:hover { border-color: var(--cyan); transform: translateY(-2px); }
  .ms-row a:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
  .ms-name { font-family: var(--font-head); font-weight: 600; font-size: 0.95rem; text-align: center; line-height: 1.25; }
  .ms-years { font-family: var(--font-mono); font-size: 0.78rem; color: var(--text-2); }
  .ms-all { margin: 18px 0 0; }
  @media (prefers-reduced-motion: reduce) { .ms-row a { transition: none; } .ms-row a:hover { transform: none; } }
</style>
