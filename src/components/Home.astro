  compute: '<rect class="d" pathLength="1" x="6" y="6" width="12" height="12" rx="2"/><path class="d" pathLength="1" d="M9 2v4M15 2v4M9 18v4M15 18v4M2 9h4M2 15h4M18 9h4M18 15h4"/><circle class="ic-pulse" cx="12" cy="12" r="2.2"/>',
  comm: '<circle class="d" pathLength="1" cx="4.5" cy="12" r="2"/><circle class="d" pathLength="1" cx="19.5" cy="12" r="2"/><path class="d" pathLength="1" d="M6.5 12c2.5-5 8.5-5 11 0M6.5 12c2.5 5 8.5 5 11 0"/><circle class="ic-photon" r="1.5" fill="currentColor" stroke="none"/>',
  lock: '<rect class="d" pathLength="1" x="5" y="11" width="14" height="10" rx="2"/><path class="d ic-shackle" pathLength="1" d="M8 11V8a4 4 0 0 1 8 0v3"/><g class="ic-lattice" fill="currentColor" stroke="none"><circle cx="9" cy="14.5" r=".9"/><circle cx="12" cy="14.5" r=".9"/><circle cx="15" cy="14.5" r=".9"/><circle cx="9" cy="17.5" r=".9"/><circle cx="12" cy="17.5" r=".9"/><circle cx="15" cy="17.5" r=".9"/></g>',
  sensor: '<circle class="d" pathLength="1" cx="12" cy="12" r="2.6"/><path class="d ic-w1" pathLength="1" d="M8.5 8.5a5 5 0 0 0 0 7M15.5 8.5a5 5 0 0 1 0 7"/><path class="d ic-w2" pathLength="1" d="M5.6 5.6a9 9 0 0 0 0 12.8M18.4 5.6a9 9 0 0 1 0 12.8"/>',
  chem: '<g class="ic-mol"><path class="d" pathLength="1" d="M8 8.2l3 7M16 8.2l-3 7M8.4 7h7.2"/><circle class="d" pathLength="1" cx="6" cy="7" r="2.2"/><circle class="d" pathLength="1" cx="18" cy="7" r="2.2"/><circle class="d" pathLength="1" cx="12" cy="17" r="2.2"/></g>',
  chip: '<ellipse class="d" pathLength="1" cx="12" cy="12" rx="9" ry="3.2"/><ellipse class="d" pathLength="1" cx="12" cy="12" rx="9" ry="3.2" transform="rotate(60 12 12)"/><ellipse class="d" pathLength="1" cx="12" cy="12" rx="9" ry="3.2" transform="rotate(-60 12 12)"/><circle cx="12" cy="12" r="1.7" fill="currentColor" stroke="none"/><circle class="ic-electron" r="1.3" fill="currentColor" stroke="none"/>',
};
const techSvg = (k) => `<svg class="ticon ticon-${k}" width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${techIcons[k]}</svg>`;
const svg = (k, s = 26) => `<svg width="${s}" height="${s}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[k]}</svg>`;
---
<section class="hero hero-nexus">
  <div class="grid-bg" aria-hidden="true"></div>
  <div class="hero-glow" aria-hidden="true"></div>
  <Particles />
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <a class="pill" href={`${pre}/lessons/`}><span class="pill-dot"></span>{c.pill}</a>
      <h1>{c.h1a.split(' ').map((w) => <><span class="w"><span>{w}</span></span>{' '}</>)}<span class="h1b">{c.h1b}</span></h1>
      <p class="lead">{c.lead}</p>
      <div class="btn-row">
        <a class="btn btn-primary btn-lg" href={`${pre}/lessons/`}>{c.cta1}</a>
        <a class="btn btn-ghost btn-lg" href={`${pre}/lab/`}>{c.cta2}</a>
      </div>
      <p class="hero-place">{c.place}</p>
      <dl class="stats">
        {c.stats.map(([n, l]) => <div><dt>{l}</dt><dd data-count={n}>{n}</dd></div>)}
      </dl>
    </div>
    <QubitHero lang={lang} />
  </div>
  <a class="scroll-cue" href="#journeys"><span></span>{c.scroll}</a>
</section>

<section class="block" id="journeys">
  <div class="wrap">
    <div class="section-head">
      <h2>{c.jT}</h2>
      <p>{c.jP}</p>
    </div>
    <div class="paths">
      {c.paths.map((p) => (
        <article class="path glass" style={`--c: ${p.c}`}>
          <Solid shape={p.solid[0]} tone={p.solid[1]} size={64} class="path-solid" />
          <span class="path-level"><span>{p.lvl}</span><span>{p.who}</span></span>
          <h3>{p.name}</h3>
          {p.note ? <p class="who">{p.note}</p> : <p class="who">&nbsp;</p>}
          <ul>{p.topics.map((t) => <li>{t}</li>)}</ul>
          <a class="btn btn-ghost" href={p.href}>{p.cta}</a>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="block" style="padding-top: 0">
  <div class="wrap">
    <div class="lab-teaser glass">
      <div>
        <p class="eyebrow">/lab</p>
        <h2>{c.labT}</h2>
        <p class="lead" style="margin-bottom: 20px">{c.labP}</p>
        <ul>{c.labList.map((l) => <li>{l}</li>)}</ul>
        <a class="btn btn-primary" href={`${pre}/lab/`}>{c.labCta}</a>
      </div>
      <div class="lab-screen" aria-hidden="true" data-shots>
        <div class="row"><span>{c.labScreen[0]}</span><b>sim</b></div>
        <div class="row"><span>{c.labScreen[1]}</span><b>H|0⟩ = (|0⟩ + |1⟩)/√2</b></div>
        <div class="row"><span>{c.labScreen[2]}</span><b data-total>× 1000</b></div>
        <div class="hist"><div data-bar style="height: 80%"><span>503</span></div><div data-bar style="height: 79%"><span>497</span></div></div>
        <div class="row"><span>|0⟩ &nbsp;·&nbsp; |1⟩</span><span>{c.labScreen[3]}: 500 · 500</span></div>
      </div>
    </div>
  </div>
</section>

<Fridge lang={lang} lessonHref={lessonUrl('superconducting-qubits-and-control-electronics')} />

<section class="block tint" id="courses">
  <div class="wrap">
    <div class="section-head">
      <h2>{c.coursesT}</h2>
      <p>{c.coursesP}</p>
    </div>
    <article class="course-main glass">
      <div class="cm-copy">
        <span class="status now">{c.open}</span>
        <h3>{course1[lang].name}</h3>
        <p>{c.c1p}</p>
        <dl class="cm-facts">{c.facts1.map(([l, v]) => <div><dt>{l}</dt><dd>{v}</dd></div>)}</dl>
        <a class="btn btn-primary" href={`${pre}/lessons/`}>{c.seeAll}</a>
        <Solid shape="orbital" tone="mix" size={170} speed={0.1} tilt={0.35} class="cm-orbital" />
      </div>
      <ol class="cm-parts">
        {partStats.map((p) => (
          <li>
            <a href={`${pre}/lessons/#part-${p.id}`}>
              <span class="cm-id">{p.id}</span>
              <span class="cm-name">{p[lang][0]}<small>{hi ? `पाठ ${p.from}–${p.to}` : `Lessons ${p.from}–${p.to}`}</small></span>
              <span class="cm-count" aria-label={c.partOfN(p.done, p.planned)}><span class="cm-bar"><i style={`width: ${(p.done / p.planned) * 100}%`}></i></span>{c.partOfN(p.done, p.planned)}</span>
            </a>
          </li>
        ))}
      </ol>
    </article>
    <div class="course-soon-row">
      {[[c.c2, 'cube', 'cobalt'], [c.c3, 'dodeca', 'gold']].map(([[name, text, chips], shape, tone], i) => (
        <article class={`course-soon glass${i === 0 ? ' course-maths' : ''}`}>
          {i === 0 && <GoldenSpiral />}
          <Solid shape={shape} tone={tone} size={70} class="course-solid" />
          <span class="status research">{c.prep}</span>
          <h3>{name}</h3>
          <p>{text}</p>
          <ul class="chips">{chips.map((x) => <li>{x}</li>)}</ul>
        </article>
      ))}
    </div>
  </div>
</section>

<section class="block">
  <div class="wrap">
    <div class="section-head">
      <h2>{c.techT}</h2>
      <p>{c.techP}</p>
    </div>
    <div class="tech">
      {c.tech.map(([ic, st, name, text, slug]) => {
        const more = slug ? lessonTag(slug) : '';
        const inner = (
          <>
            <span class="tech-top"><Fragment set:html={techSvg(ic)} /><span class={`status ${st}`}>{c.st[st]}</span></span>
            <h3>{name}</h3>
            <p>{text}</p>
            <span class="tech-more">{more}</span>
          </>
        );
        return slug ? <a class="tech-card glass" href={lessonUrl(slug)}>{inner}</a> : <div class="tech-card glass">{inner}</div>;
      })}
    </div>
  </div>
</section>

<Mobius lang={lang} lessonHref={lessonUrl('rotations-and-any-single-qubit-gate')} />

<section class="block how-section">
  <div class="wrap">
    <div class="section-head">
      <h2>{c.howT}</h2>
      <p>{c.howP}</p>
    </div>
    <ol class="how-steps">
      {c.how.map(([h, p]) => <li><strong>{h}</strong><span>{p}</span></li>)}
    </ol>
  </div>
</section>

<section class="block kota">
  <div class="wrap kota-grid">
    <div>
      <p class="eyebrow">Kota, Rajasthan · 25.2° N, 75.8° E</p>
      <h2>{c.kT}</h2>
      <p class="lead">{c.kP}</p>
      <p style="color: var(--text-2)">{c.kSub}</p>
      <a class="btn btn-light" href={`${pre}/why-kota/`}>{c.kLink}</a>
    </div>
    <ul class="tiles">
      {c.facts.map(([k, h, p]) => (
        <li class="glass"><Fragment set:html={svg(k, 28)} /><strong>{h}</strong><span>{p}</span></li>
      ))}
    </ul>
  </div>
</section>

<section class="quote-section">
  <div class="wrap">
    <figure class="quote">
      <GoldInfinity />
      <blockquote>{c.quote}</blockquote>
      <figcaption>{c.quoteBy}</figcaption>
    </figure>
  </div>
</section>

<section class="block tint">
  <div class="wrap ig-grid">
    <div>
      <h2>{c.igT}</h2>
      <p class="ig-text">{c.igP}</p>
      <div class="log">
        <h3>{c.logT}</h3>
        <p>{c.logP}</p>
        <PostList posts={latest} lang={lang} />
        <p><a href={`${pre}/about/`}>{c.about}</a></p>
      </div>
    </div>
    <div class="ig-card glass">
      <div class="ig-top">
        <img src="/favicon.svg" alt="" width="56" height="56" />
        <div><strong>{site.instagramHandle}</strong><span>Kota Quantum Valley</span></div>
      </div>
      <p>{c.igCard}</p>
      <div class="btn-row">
        <a class="btn btn-primary" href={site.instagram} rel="noopener" target="_blank">{c.igBtn}</a>
        {site.instagramDM && <a class="btn btn-ghost" href={site.instagramDM} rel="noopener" target="_blank">{c.igDm}</a>}
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/home-motion.js';
</script>
