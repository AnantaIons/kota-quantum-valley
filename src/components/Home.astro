---
import PostList from './PostList.astro';
import QubitHero from './QubitHero.astro';
import Particles from './Particles.astro';
import Fridge from './Fridge.astro';
import Mobius from './Mobius.astro';
import GoldInfinity from './GoldInfinity.astro';
import Solid from './Solid.astro';
import GoldenSpiral from './GoldenSpiral.astro';
import site from '../data/site.json';
import { getPosts } from '../lib/posts.js';
import { course1, syllabus, lessonNumber, partOf } from '../data/course.js';
import { quizzes } from '../data/quizzes.js';

const { lang = 'en' } = Astro.props;
const hi = lang === 'hi';
const pre = hi ? '/hi' : '';
const lessons = getPosts('lesson', lang);
const published = new Set(lessons.map((p) => p.slug));
// Link to a lesson if it's published, otherwise to its part on the course page.
const lessonUrl = (slug) => published.has(slug) ? (hi ? `/hi/lessons/${slug}/` : `/posts/${slug}/`) : `${pre}/lessons/#part-${partOf(lessonNumber(slug) ?? 0)?.id ?? 'A'}`;
const lessonTag = (slug) => (hi ? `पाठ ${lessonNumber(slug)}` : `Lesson ${lessonNumber(slug)}`);
const latest = getPosts(undefined, lang).filter((p) => p.category !== 'lesson').slice(0, 3);
const lessonCount = lessons.length;
const quizCount = lessons.reduce((n, p) => n + (quizzes[p.slug]?.length ?? 0), 0);
const sources = Object.values(import.meta.glob('../pages/posts/*.md', { query: '?raw', import: 'default', eager: true }));
const codeCount = sources.reduce((n, src) => n + (String(src).match(/```python/g) || []).length, 0);
const partStats = course1.parts.map((p) => {
  const all = syllabus.filter((s) => s.n >= p.from && s.n <= p.to);
  return { ...p, planned: all.length, done: all.filter((s) => published.has(s.slug)).length };
});

const c = hi ? {
  pill: 'नया: कोर्स 1 पूरा हुआ, 50 विस्तृत पाठ',
  h1a: 'भविष्य क्वांटम है।', h1b: 'आपका सफ़र यहीं से शुरू होता है।',
  lead: 'शून्य से क्वांटम कंप्यूटिंग सीखिए: ऐसे पाठ जो हर क़दम समझाते हैं, चलने वाला कोड, और आपके ब्राउज़र में प्रयोग। मुफ़्त, हिन्दी और अंग्रेज़ी में।',
  cta1: 'कोर्स 1 शुरू करें', cta2: 'क्वांटम लैब खोलें',
  place: 'हमेशा मुफ़्त · हिन्दी और English · शुरुआत कोटा, राजस्थान से।', scroll: 'स्क्रॉल करें',
  stats: [[lessonCount, 'पाठ प्रकाशित'], [codeCount, 'टेस्ट किए code programs'], [quizCount, 'quiz सवाल'], ['4', 'लैब प्रयोग']],
  jT: 'अपना क्वांटम सफ़र चुनें', jP: 'तीन रास्ते, आपके स्तर के हिसाब से। हर रास्ता हमारे मौजूदा पाठों से जुड़ा है, और नए पाठ जुड़ते रहेंगे।',
  paths: [
    { solid: ['tetra', 'green'], c: '#39E6A0', lvl: 'रास्ता 1', name: 'Quantum Explorer', who: 'कक्षा 8–10', topics: ['Bits और logic gates', 'Qubit से परिचय', 'Superposition', 'Measurement', 'Entanglement की बुनियाद', 'आज की क्वांटम तकनीक'], cta: 'पाठ 1 से शुरू करें', href: lessonUrl('bits-and-classical-computing') },
    { solid: ['octa', 'gold'], c: '#E6C36A', lvl: 'रास्ता 2', name: 'Quantum Scientist', who: 'कक्षा 11–12 और JEE छात्र', topics: ['Complex numbers', 'Vectors और matrices', 'Bloch sphere', 'Quantum gates', 'Circuits', 'Interference'], cta: 'रोडमैप से शुरू करें', href: lessonUrl('roadmap-what-to-learn-first'), note: 'यह JEE सिलेबस का हिस्सा नहीं है, लेकिन उसी फ़िज़िक्स और मैथ्स पर बना है।' },
    { solid: ['icosa', 'cobalt'], c: '#2979FF', lvl: 'रास्ता 3', name: 'Quantum Architect', who: 'कॉलेज और एडवांस्ड छात्र', topics: ['Tensor products', 'Bell tests', 'Deutsch–Jozsa', 'Grover', 'QFT और Shor', 'Error correction', 'Hardware', 'QKD'], cta: 'पाठ 12 से शुरू करें', href: lessonUrl('many-qubits-and-the-tensor-product') },
  ],
  labT: 'क्वांटम फ़िज़िक्स सिर्फ़ पढ़ें नहीं। उसके साथ प्रयोग करें।', labP: 'हमारी क्वांटम लैब आपके ब्राउज़र में एक असली state-vector simulator चलाती है।',
  labList: ['Bloch sphere पर X, Y, Z, H, S, T gates लगाएँ', 'Qubit को 1,000 बार measure करें और histogram देखें', 'H + CNOT से Bell state बनाएँ और correlation देखें', 'अपना circuit बनाएँ (4 qubits तक) और Qiskit code निकालें'],
  labCta: 'क्वांटम लैब खोलें', labScreen: ['प्रयोग 2 · superposition', 'स्टेट', 'measure', 'सिद्धांत'],
  coursesT: 'हमारे कोर्स', coursesP: 'शून्य से शुरू होकर एक-एक क़दम आगे। कोर्स 1 अभी खुला है; अगले दो तैयार हो रहे हैं।',
  open: 'अभी खुला', prep: 'तैयार हो रहा है', c1p: 'Bits और complex numbers से शुरू करके qubits, gates, entanglement, algorithms, error correction, हार्डवेयर और आपके करियर के रास्ते तक। 9 भाग, हर पाठ में कोड और quiz।',
  facts1: [['पाठ', syllabus.length], ['भाग', course1.parts.length], ['प्रकाशित', lessons.length]], seeAll: 'सभी पाठ देखें', partOfN: (d, n) => `${n} में से ${d}`,
  c2: ['कोर्स 2: Mathematics for Quantum Science', 'कक्षा 10 की नींव से quantum theory के गणित तक, एक-एक क़दम। हर विचार पहले सहज रूप में, फिर पूरे derivation और हल किए अभ्यासों के साथ।', ['Algebra', 'Complex numbers', 'Linear algebra', 'Calculus', 'Probability']],
  c3: ['कोर्स 3: IBM Quantum सीरीज़', 'IBM Quantum Learning के सिलेबस के क्रम में, हमारी अपनी व्याख्या के साथ, और असली IBM हार्डवेयर पर प्रयोग।', ['Basics of quantum information', 'Algorithms', 'Error correction', 'Utility-scale']],
  howT: 'हर पाठ कैसे बना है', howP: 'कोई स्लाइड नहीं, कोई shortcut नहीं। हर पाठ एक ही क्रम में चलता है, ताकि आप हर विचार को पूरी तरह समझें।',
  how: [['आसान भाषा में विचार', 'जो आप पहले से जानते हैं वहाँ से शुरुआत, रोज़ की मिसाल के साथ।'], ['मैथ्स, धीरे-धीरे', 'हर क़दम लिखा हुआ, 11वीं-12वीं की मैथ्स से।'], ['चलने वाला कोड', 'Qiskit में टेस्ट किया हुआ, साथ में वह output जो आपको दिखना चाहिए।'], ['ख़ुद करके देखें', 'छोटे अभ्यास, जवाबों के साथ।'], ['सार', 'पूरा पाठ एक स्क्रीन पर, दोहराने के लिए।'], ['Quiz', 'चार सवाल, हर जवाब का कारण, फिर पाठ पूरा।']],
  techT: 'कल को आकार देने वाली तकनीकें', techP: 'क्वांटम एक तकनीक नहीं, कई हैं। कुछ आज इस्तेमाल हो रही हैं, कुछ अभी research में हैं। हम साफ़ बताते हैं कौन-सी कहाँ है।',
  st: { now: 'आज इस्तेमाल में', early: 'शुरुआती दौर', research: 'research में' },
  tech: [
    ['compute', 'early', 'क्वांटम कंप्यूटिंग', 'Superposition और interference से कुछ ख़ास समस्याएँ तेज़ हल करना। छोटी मशीनें cloud पर उपलब्ध हैं; बड़ा व्यावहारिक फ़ायदा अभी research है।', 'what-quantum-computers-can-and-cant-do'],
    ['comm', 'early', 'क्वांटम कम्युनिकेशन', 'QKD: ऐसी keys जिनकी जासूसी physics पकड़ लेती है। Fibre और satellite पर शुरुआती नेटवर्क चल रहे हैं।', 'quantum-communication-and-qkd'],
    ['lock', 'now', 'क्वांटम-सुरक्षित क्रिप्टोग्राफ़ी', 'Post-quantum cryptography नई गणित पर टिकी है और आज के हार्डवेयर पर चलती है। NIST standards 2024 में आए। (QKD से अलग है।)', 'post-quantum-cryptography'],
    ['sensor', 'now', 'क्वांटम सेंसर', 'Atomic clocks और SQUID दशकों से इस्तेमाल में हैं। Diamond NV और atom gravimeter जैसे नए sensor आ रहे हैं।', 'quantum-sensing'],
    ['chem', 'research', 'क्वांटम केमिस्ट्री', 'Molecules और materials का simulation, जैसे नई दवाएँ और बैटरी। यह quantum computers के सबसे बड़े वादों में से एक है, अभी research में।', 'quantum-chemistry-and-machine-learning'],
    ['chip', 'research', 'क्वांटम हार्डवेयर', 'Superconducting qubits, trapped ions, neutral atoms, photons। हर platform की अपनी ताक़त और चुनौती है।', 'how-real-qubits-are-built'],
  ],
  kT: 'कोटा से क्वांटम की सीमा तक', kP: 'बड़ी वैज्ञानिक खोजें जिज्ञासा से शुरू होती हैं। आपका सफ़र यहीं से शुरू हो सकता है।', kSub: 'कोटा की कक्षाओं से क्वांटम की सीमा तक।', kLink: 'कोटा का पूरा पक्ष पढ़ें',
  facts: [
    ['talent', 'टैलेंट पहले से यहाँ है', 'लाखों छात्रों ने कोटा में JEE-स्तर की फ़िज़िक्स और मैथ्स सीखी है।'],
    ['teach', 'शिक्षक भी यहीं हैं', 'एक पूरा शहर जिसका काम कठिन विज्ञान को आसान बनाना है।'],
    ['cost', 'बनाने का ख़र्च कम', 'बेंगलुरु या दिल्ली NCR से सस्ता रहना, भर्ती करना और लैब लगाना।'],
    ['time', 'समय सही है', '₹6,003 करोड़ का नेशनल क्वांटम मिशन अभी हब बना रहा है। राजस्थान की अभी कोई क्वांटम योजना नहीं है।'],
  ],
  quote: 'जो छात्र JEE की फ़िज़िक्स समझ सकता है, वह क्वांटम कंप्यूटिंग भी सीख सकता है। उसे बस सही क्रम और सही भाषा चाहिए।', quoteBy: 'हमारा विश्वास',
  igT: 'इंस्टाग्राम पर हमसे जुड़ें।', igP: `नए पाठों की ख़बर, छोटे quantum facts और सवालों के जवाब ${site.instagramHandle} पर। कोई सवाल हो तो सीधे मैसेज करें।`, igBtn: 'इंस्टाग्राम पर फ़ॉलो करें', igDm: 'मैसेज करें', igCard: 'कोटा से, क्वांटम की पढ़ाई। हर हफ़्ते नए पाठ।',
  logT: 'सबके सामने सीखना', logP: `Kota Quantum Valley की शुरुआत ${site.founderName} ने की है, जो राजस्थान के एक एम्बेडेड फ़र्मवेयर इंजीनियर हैं और क्वांटम शून्य से सीख रहे हैं।`, about: 'इस पहल के बारे में',
