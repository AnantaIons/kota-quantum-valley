---
import '../styles/global.css';
import Logo from '../components/Logo.astro';
import ChatButton from '../components/ChatButton.astro';
import site from '../data/site.json';
import { t, langOf, altPath } from '../i18n.js';

const { title, image = '/og.png', description = 'Kota trains India\'s sharpest physics minds. Kota Quantum Valley teaches quantum computing from absolute zero, for free, and makes the case for quantum jobs in Kota.' } = Astro.props;
const pageTitle = title ? `${title} | Kota Quantum Valley` : 'Kota Quantum Valley | Learn quantum computing from absolute zero';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const lang = Astro.props.lang ?? langOf(Astro.url.pathname);
const L = t[lang];
const nav = L.nav.map(([href, label]) => ({ href, label }));
const lessonsHref = lang === 'hi' ? '/hi/lessons/' : '/lessons/';
const isCurrent = (href) => path === href.replace(/\/$/, '') || (href === lessonsHref && (path.startsWith('/posts/lesson') || path.startsWith('/hi/lessons/')));
const alt = altPath(Astro.url.pathname);
const isHome = path === '/' || path === '/hi';
const announcement = isHome ? '' : (lang === 'hi' ? site.announcementHindi : site.announcement);
const homeHref = lang === 'hi' ? '/hi/' : '/';
const pre = lang === 'hi' ? '/hi' : '';
const ogImage = new URL(image, Astro.site).href;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:site_name" content="Kota Quantum Valley" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#121034" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    {lang === 'hi' && <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Devanagari:wght@400;500;600&family=Mukta:wght@600;700;800&display=swap" rel="stylesheet" />}
    <link rel="alternate" hreflang={lang === 'hi' ? 'en' : 'hi'} href={new URL(alt, Astro.site)} />
  </head>
  <body>
    {announcement && (
      <div class="announce"><a href={lessonsHref}><span>{L.newLabel}</span>{announcement.replace(/^(New|नया):\s*/, '')}</a></div>
    )}
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href={homeHref} aria-label="Kota Quantum Valley, home">
          <Logo size={34} bar="currentColor" />
          <span class="brand-name">Kota Quantum Valley<small>{L.tagline}</small></span>
        </a>
        <nav class="nav" aria-label="Main">
          {nav.map((n) => (
            <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>
          ))}
          <a class="lang-switch" href={alt} hreflang={lang === 'hi' ? 'en' : 'hi'} aria-label={L.switchAria}>{L.switchLabel}</a>
          <a class="btn btn-dark btn-sm" href={L.startHref}>{L.start}</a>
        </nav>
        <a class="lang-switch lang-mobile" href={alt} hreflang={lang === 'hi' ? 'en' : 'hi'} aria-label={L.switchAria}>{L.switchLabel}</a>
        <details class="menu">
          <summary aria-label={L.menu}>{L.menu}</summary>
          <div class="menu-panel">
            {nav.map((n) => <a href={n.href}>{n.label}</a>)}
            <a href={`${pre}/explainers/`}>{L.explainers}</a>
            <a class="btn btn-dark" href={L.startHref} style="margin-top: 6px; color: #fff">{L.start}</a>
          </div>
        </details>
      </div>
    </header>

    <main>
      <slot />
    </main>
    <ChatButton lang={lang} />

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div class="footer-about">
            <a class="brand" href={homeHref} style="color: #fff">
              <Logo size={34} bar="#ffffff" />
              <span class="brand-name">Kota Quantum Valley</span>
            </a>
            <p>{L.footAbout}</p>
          </div>
          <div>
            <h4>{L.footLearn}</h4>
            <ul>
              <li><a href={L.startHref}>{L.roadmap}</a></li>
              <li><a href={lessonsHref}>{L.allLessons}</a></li>
              <li><a href={`${pre}/explainers/`}>{L.explainers}</a></li>
              <li><a href={`${pre}/learn/`}>{L.learningLog}</a></li>
            </ul>
          </div>
          <div>
            <h4>{L.footInit}</h4>
            <ul>
              <li><a href={lang === 'hi' ? '/hi/why-kota/' : '/why-kota/'}>{L.whyKota}</a></li>
              <li><a href={`${pre}/careers/`}>{L.careers}</a></li>
              <li><a href={lang === 'hi' ? '/hi/about/' : '/about/'}>{L.about}</a></li>
            </ul>
          </div>
          <div>
            <h4>{L.footFollow}</h4>
            <ul>
              <li><a href={site.instagram} rel="me noopener" target="_blank">Instagram</a></li>
              {site.instagramDM && <li><a href={site.instagramDM} rel="noopener" target="_blank">{L.chatButton}</a></li>}
              {site.linkedin && <li><a href={site.linkedin} rel="me noopener" target="_blank">LinkedIn</a></li>}
              {site.youtube && <li><a href={site.youtube} rel="me noopener" target="_blank">YouTube</a></li>}
              {site.email && <li><a href={`mailto:${site.email}`}>Email</a></li>}
            </ul>
          </div>
        </div>
        <div class="footer-base">
          <span>© {year} Kota Quantum Valley</span>
          <span>{L.license.split('{cc}')[0]}<a href="https://creativecommons.org/licenses/by-nc-nd/4.0/" rel="license noopener" target="_blank">CC BY-NC-ND 4.0</a>{L.license.split('{cc}')[1]}</span>
        </div>
      </div>
    </footer>
  </body>
</html>
