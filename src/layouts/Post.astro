---
import Base from './Base.astro';
import { formatDate, getPosts, lessonLabel, slugOf } from '../lib/posts.js';
import { t } from '../i18n.js';
import { coverSvg } from '../data/covers.js';
import Quiz from '../components/Quiz.astro';
import MarkDone from '../components/MarkDone.astro';
import { course1, partOf, lessonNumber } from '../data/course.js';

const { frontmatter, headings = [], rawContent } = Astro.props;
const lang = frontmatter.lang === 'hi' ? 'hi' : 'en';
const L = t[lang];
const slug = slugOf(Astro.url.pathname);
const isLesson = frontmatter.category === 'lesson';
const n = isLesson ? (lessonNumber(slug) ?? frontmatter.lesson ?? 0) : null;
const labels = { journey: L.journeyTag, explainer: L.explainerTag };
const pre = lang === 'hi' ? '/hi' : '';
const lessonsHref = lang === 'hi' ? '/hi/lessons/' : '/lessons/';
const back = isLesson ? [lessonsHref, L.allLessons] : frontmatter.category === 'explainer' ? [`${pre}/explainers/`, L.allExplainers] : [`${pre}/learn/`, L.theLog];
const eyebrow = isLesson ? lessonLabel({ lesson: n }, lang) : `${labels[frontmatter.category] ?? frontmatter.category}${frontmatter.day ? `, ${L.day(frontmatter.day)}` : ''}`;
let prev, next;
if (isLesson) {
  const all = getPosts('lesson', lang);
  const i = all.findIndex((p) => p.slug === slug);
  prev = all[i - 1]; next = all[i + 1];
}
const part = isLesson ? partOf(n) : null;
const raw = typeof rawContent === 'function' ? rawContent() : '';
const words = raw.replace(/```[\s\S]*?```/g, ' ').split(/\s+/).filter(Boolean).length;
const mins = words ? Math.max(1, Math.round(words / 200)) : 0;
const toc = isLesson ? headings.filter((h) => h.depth === 2) : [];
const sectioned = (isLesson || frontmatter.category === 'explainer') && headings.some((h) => h.depth === 2);
// Turn each h2 section into a collapsible <details>; the intro stays visible and the first section starts open.
const content = await Astro.slots.render('default');
const wrapSections = (html) => {
  const [intro, ...parts] = html.split(/(?=<h2[\s>])/);
  return intro + parts.map((chunk, i) => {
    const end = chunk.indexOf('</h2>') + 5;
    return `<details class="lsec"${i === 0 ? ' open' : ''}><summary class="lsec-sum">${chunk.slice(0, end)}</summary><div class="lsec-body">${chunk.slice(end)}</div></details>`;
  }).join('');
};
// Wide tables scroll sideways inside their own box instead of widening the page on phones
const wrapTables = (html) => html.replace(/<table>/g, '<div class="table-wrap"><table>').replace(/<\/table>/g, '</table></div>');
const body = wrapTables(sectioned ? wrapSections(content) : content);
const image = isLesson ? `/covers/${slug}.jpg` : undefined;
---
<Base title={frontmatter.title} description={frontmatter.description} image={image} lang={lang}>
  <article class="article" data-pagefind-body>
    <div class="narrow">
      <header>
        <p class="eyebrow">{eyebrow}{part && <span class="part-tag">, {course1[lang].short}, {lang === 'hi' ? 'भाग' : 'Part'} {part.id}: {part[lang][0]}</span>}</p>
        <h1>{frontmatter.title}</h1>
        {frontmatter.description && <p class="desc">{frontmatter.description}</p>}
        <p class="meta" style="margin: 0">{L.published(formatDate(frontmatter.date, lang), mins)}</p>
      </header>
    </div>
    {isLesson && <div class="post-cover" aria-hidden="true"><Fragment set:html={coverSvg(slug, n)} /></div>}
    <div class="narrow">
      {toc.length > 3 && (
        <nav class="lesson-toc glass" aria-label={lang === 'hi' ? 'इस पाठ में' : 'In this lesson'}>
          <strong>{lang === 'hi' ? 'इस पाठ में' : 'In this lesson'}</strong>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
      {sectioned && (
        <div class="lsec-tools" data-lsec-tools>
          <span>{lang === 'hi' ? `${toc.length} हिस्से, हर एक खोलने के लिए उसके शीर्षक पर टैप करें` : `${toc.length} sections. Tap a heading to open it.`}</span>
          <button type="button" class="btn btn-ghost btn-sm" data-lsec-toggle data-open={lang === 'hi' ? 'सब खोलें' : 'Expand all'} data-close={lang === 'hi' ? 'सब बंद करें' : 'Collapse all'}>{lang === 'hi' ? 'सब खोलें' : 'Expand all'}</button>
        </div>
      )}
      <Fragment set:html={body} />
      {isLesson && <Quiz slug={slug} n={n} lang={lang} />}
      {isLesson && <MarkDone slug={slug} lang={lang} />}
      <hr style="border: 0; border-top: 1px solid var(--line); margin: 48px 0 24px" />
      {isLesson ? (
        <div class="lesson-nav">
          {prev ? <a href={prev.url}><small>{L.prev}: {lessonLabel(prev, lang)}</small><strong>{prev.title}</strong></a> : <a href={back[0]}><small>{L.backTo}</small><strong>{back[1]}</strong></a>}
          {next && <a class="next" href={next.url}><small>{L.next}: {lessonLabel(next, lang)}</small><strong>{next.title}</strong></a>}
        </div>
      ) : <p><a href={back[0]}>{L.backTo}: {back[1]}</a></p>}
    </div>
  </article>
</Base>
<script>
  // Collapsible lesson sections: open the one a link points to, toggle all, and open everything for printing.
  const sections = [...document.querySelectorAll('details.lsec')] as HTMLDetailsElement[];
  const toggle = document.querySelector('[data-lsec-toggle]') as HTMLButtonElement | null;
  const refresh = () => {
    if (!toggle) return;
    const allOpen = sections.every((d) => d.open);
    toggle.textContent = allOpen ? toggle.dataset.close! : toggle.dataset.open!;
    toggle.setAttribute('aria-pressed', String(allOpen));
  };
  const openFor = (hash: string, scroll = false) => {
    if (!hash || hash.length < 2) return;
    const target = document.getElementById(decodeURIComponent(hash.slice(1)));
    const box = target?.closest('details.lsec') as HTMLDetailsElement | null;
    if (box && !box.open) box.open = true;
    if (target && scroll) target.scrollIntoView();
  };
  sections.forEach((d) => d.addEventListener('toggle', refresh));
  toggle?.addEventListener('click', () => {
    const open = !sections.every((d) => d.open);
    sections.forEach((d) => { d.open = open; });
    refresh();
  });
  openFor(location.hash, true);
  addEventListener('hashchange', () => openFor(location.hash, true));
  document.addEventListener('click', (e) => {
    const a = (e.target as HTMLElement).closest('a[href^="#"]') as HTMLAnchorElement | null;
    if (a) openFor(a.getAttribute('href')!);
  });
  addEventListener('beforeprint', () => sections.forEach((d) => { d.open = true; }));
  refresh();
</script>
